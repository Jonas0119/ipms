<view class="ipms-calendar__header">
    <block wx:if="{{ showTitle }}">
        <view class="ipms-calendar__header-title"><slot name="title"></slot></view>
        <view class="ipms-calendar__header-title">{{ title }}</view>
    </block>

    <view wx:if="{{ showSubtitle }}" class="ipms-calendar__header-subtitle">
        {{ subtitle }}
    </view>

    <view class="ipms-calendar__weekdays">
        <view wx:for="{{ weekdays }}" wx:key="index" class="ipms-calendar__weekday">
            {{ item }}
        </view>
    </view>
</view>
