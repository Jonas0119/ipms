<wxs src="../common/common.wxs" module="common" />
<wxs src="./index.wxs" module="payment" />

<view class="container">
    <ipms-list
        fetching="{{fetching}}"
        page_num="{{page_num}}"
        page_amount="{{page_amount}}"
        list="{{list}}"
        empty="暂无缴费记录"
        icon="pay"
    >
        <ipms-list-item
            wx:for="{{list}}"
            title="{{payment.tradeNo(item.created_at, item.order_id)}}"
            wx:key="index"
            status="{{item.community_name}}小区"
            url="/pages/payment/detail?id={{item.id}}"
            useFooterSlot="{{curStamp - payExpire < item.created_at && !item.cancel && !item.paid}}"
        >
            <ipms-list-item-info label="缴费年度">
                {{item.start_year}}至{{item.end_year}}年
            </ipms-list-item-info>
            <ipms-list-item-info label="缴费金额">
                {{payment.yuan(item.fee)}}元
            </ipms-list-item-info>
            <ipms-list-item-info label="订单状态">
                <block wx:if="{{item.cancel}}">
                    <ipms-tag round color="#ff9900">已取消</ipms-tag>
                </block>
                <block wx:elif="{{item.refunding && !item.refunded}}">
                    <ipms-tag round color="#CB51CB">待退款</ipms-tag>
                </block>
                <block wx:elif="{{item.refunding && item.refunded}}">
                    <ipms-tag round color="#51C6CB">{{ item.paid_fee == 0 ? '完全退款成功' : '部分退款成功' }}</ipms-tag>
                </block>
                <block wx:elif="{{item.paid}}">
                    <ipms-tag round color="#00cc66">已支付</ipms-tag>
                </block>
                <block wx:elif="{{curStamp - payExpire >= item.created_at}}">
                    <ipms-tag round color="#ff3300">已超时</ipms-tag>
                </block>
                <block wx:else>
                    <ipms-tag round color="#3399ff">待支付</ipms-tag>
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="退款金额" wx:if="{{item.fee !== item.paid_fee && item.paid}}">
                {{payment.yuan(item.fee - item.paid_fee)}}元
            </ipms-list-item-info>
            <ipms-list-item-info label="交易单号" wx:if="{{item.transaction_id}}">
                {{item.transaction_id}}
            </ipms-list-item-info>
            <ipms-list-item-info label="订单时间">
                {{common.date(item.created_at)}}
            </ipms-list-item-info>

            <view slot="footer">
                <ipms-button size="small" round type="warning" data-id="{{item.order_id}}" catch:tap="cancelOrder">
                    取消订单
                </ipms-button>
                <ipms-button
                    size="small"
                    round
                    custom-class="btn-ml"
                    type="danger"
                    class="btn"
                    data-id="{{item.order_id}}"
                    catch:tap="payOrder"
                >
                    支付
                </ipms-button>
            </view>
        </ipms-list-item>
    </ipms-list>

    <ipms-dialog id="ipms-dialog" />
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
