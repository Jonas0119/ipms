<wxs src="../common/common.wxs" module="common" />
<wxs src="./index.wxs" module="mission" />

<view class="container">
    <view wx:if="{{fetching}}">
        <ipms-timeline wx:for="{{5}}" wx:key="index" first="{{index === 0}}" last="{{index === 4}}">
            <ipms-skeleton title row="5" />
        </ipms-timeline>
    </view>

    <view wx:esle>
        <ipms-timeline
            wx:for="{{list}}"
            wx:key="index"
            title="{{item.local}}"
            first="{{index === 0}}"
            last="{{index === list.length - 1}}"
        >
            <ipms-row>
                <ipms-col span="6">
                    是否正常：
                </ipms-col>
                <ipms-col span="18">
                    <ipms-tag color="{{ item.normal ? '#19be6b' : '#f90' }}">{{ item.normal ? '是' : '否' }}</ipms-tag>
                </ipms-col>
            </ipms-row>
            <ipms-row>
                <ipms-col span="6">
                    巡检备注：
                </ipms-col>
                <ipms-col span="18">
                    {{ item.remark ? item.remark : '-' }}
                </ipms-col>
            </ipms-row>
            <ipms-row>
                <ipms-col span="6">
                    现场图片：
                </ipms-col>
                <ipms-col span="18">
                    <ipms-image
                        wx:for="{{item.imgs}}"
                        wx:key="index"
                        src="{{ASSETS_HOST}}{{item}}"
                        width="80px"
                        height="80px"
                        custom-class="pre-img"
                        data-index="{{index}}"
                        data-id="{{item.id}}"
                        bind:click="showImg"
                    />
                </ipms-col>
            </ipms-row>
            <ipms-row>
                <ipms-col span="6">
                    图片相似度：
                </ipms-col>
                <ipms-col span="18">
                    {{ mission.like(item.like, item.imgs.length) }}%
                </ipms-col>
            </ipms-row>
            <ipms-row>
                <ipms-col span="6">
                    巡检时间：
                </ipms-col>
                <ipms-col span="18">
                    {{ common.date(item.created_at) }}
                </ipms-col>
            </ipms-row>
        </ipms-timeline>
    </view>

    <ipms-copyright />

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
</view>
