<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <view wx:if="{{!fetching}}">
        <view>
            <view class="photo">
                <image src="{{ASSETS_HOST}}{{detail.info.photo}}" mode="widthFix" />
            </view>
        </view>

        <ipms-cell-group title="基本信息">
            <ipms-cell title="宠物名：" value="{{detail.info.name}}" is-detail />
            <ipms-cell title="种类：" value="{{detail.info.pet_type === 1 ? '犬' : '未知'}}" is-detail />
            <ipms-cell title="性别：" value="{{detail.info.sex === 0 ? '雌' : '雄'}}" is-detail />
            <ipms-cell title="品种：" value="{{detail.info.breed}}" is-detail />
            <ipms-cell title="毛色：" value="{{detail.info.coat_color}}" is-detail />
            <ipms-cell title="所在小区：" value="{{detail.info.community_name}}" is-detail border="{{false}}" />
        </ipms-cell-group>

        <ipms-cell-group title="宠物登记信息" wx:if="{{!fillPetLicense}}">
            <ipms-panel use-footer-slot wx:if="{{!detail.info.pet_license}}">
                <view class="panel-container">
                    <view class="nodata">尚未办理宠物登记</view>
                    <view class="notice">
                        办理宠物登记具体请咨询小区所在居委会、派出所；根据互联网公开资料显示，办理宠物登记需持宠物免疫（接种疫苗）凭证，有完全民事能力且有固定住所（住所需在禁养区域外）的公民身份证件，携带宠物正面、侧面照片及相关信息资料办理。
                    </view>
                </view>
                <view slot="footer" class="footer">
                    <ipms-button size="small" round type="info" bind:click="showPetLicense">
                        添加宠物登记信息
                    </ipms-button>
                </view>
            </ipms-panel>
            <view wx:else>
                <ipms-cell title="证书编号：" value="{{detail.info.pet_license}}" is-detail border="{{false}}" />
                <ipms-cell
                    title="发证时间："
                    value="{{common.date(detail.info.pet_license_award_at, false)}}"
                    is-detail
                    border="{{false}}"
                />
            </view>
        </ipms-cell-group>
        <ipms-panel use-footer-slot wx:else custom-class="section" title="上传宠物登记信息">
            <ipms-field
                label="证书编号"
                maxlength="{{ 40 }}"
                show-word-limit
                model:value="{{ pet_license }}"
                placeholder="请输入证书编号"
            />
            <ipms-cell
                title="发证时间"
                value="{{!pet_license_award_at ? '请选择发证时间' : common.date(pet_license_award_at, false)}}"
                is-link
                clickable
                border="{{false}}"
                bind:click="showlicenseCalendar"
            />
            <view slot="footer" class="footer">
                <ipms-button size="small" round bind:click="hidePetLicense">
                    取消
                </ipms-button>
                <ipms-button size="small" round type="info" loading="{{licenseSubmiting}}" bind:click="updatePetLicense">
                    确认
                </ipms-button>
            </view>
        </ipms-panel>

        <ipms-cell-group title="接种信息">
            <ipms-panel wx:if="{{!detail.vaccinates.length}}">
                <view class="panel-container">
                    <view class="nodata">暂无接种信息</view>
                </view>
            </ipms-panel>
            <ipms-cell
                is-link
                wx:if="{{!fillVaccinate}}"
                bind:click="showVaccinate"
                border="{{detail.vaccinates.length === 0 ? false : true}}"
                title="添加接种信息"
            />
            <ipms-panel use-footer-slot wx:else title="上传宠物接种信息">
                <ipms-cell
                    title="最近一次接种疫苗时间"
                    value="{{!vaccinated_at ? '请选择接种时间' : common.date(vaccinated_at, false)}}"
                    is-link
                    clickable
                    bind:click="showVaccinateCalendar"
                />
                <ipms-field
                    label="疫苗类型"
                    maxlength="{{ 32 }}"
                    show-word-limit
                    model:value="{{ vaccine_type }}"
                    placeholder="请输入疫苗类型"
                    border="{{false}}"
                />
                <view slot="footer" class="footer">
                    <ipms-button size="small" round bind:click="hideVaccinate">
                        取消
                    </ipms-button>
                    <ipms-button
                        size="small"
                        round
                        type="info"
                        loading="{{vaccianteSubmiting}}"
                        bind:click="updateVaccinate"
                    >
                        确认
                    </ipms-button>
                </view>
            </ipms-panel>
            <ipms-cell
                wx:for="{{detail.vaccinates}}"
                wx:key="index"
                border="{{false}}"
                title="{{common.date(item.vaccinated_at, false)}}接种"
                border="{{index !== detail.vaccinates.length - 1}}"
                label="{{item.vaccine_type}}"
            />
        </ipms-cell-group>

        <view class="remove-btn-wrapper">
            <ipms-button block type="danger" bind:click="showRemoveAction">注销宠物</ipms-button>
        </view>
    </view>
    <view wx:else>
        <view>
            <view class="photo" />
        </view>

        <ipms-cell-group title="基本信息" wx:if="{{fetching}}">
            <ipms-cell is-detail title="宠物名：" border="{{false}}">
                <ipms-skeleton in-cell row="2" />
            </ipms-cell>
            <ipms-cell is-detail title="种类：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
            <ipms-cell is-detail title="性别：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
            <ipms-cell is-detail title="品种：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
            <ipms-cell is-detail title="毛色：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
        </ipms-cell-group>

        <ipms-cell-group title="宠物登记信息" wx:if="{{fetching}}">
            <ipms-cell is-detail title="证书编号：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
            <ipms-cell is-detail title="发证时间：" border="{{false}}">
                <ipms-skeleton in-cell row="1" />
            </ipms-cell>
        </ipms-cell-group>
    </view>

    <ipms-copyright />
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />

    <ipms-action-sheet
        title="注销原因"
        close-on-click-overlay="{{true}}"
        show="{{removeActionVisible}}"
        bind:close="hideRemoveAction"
        bind:select="onRemoveReasonChange"
        actions="{{removeActions}}"
    />

    <ipms-calendar
        show="{{licenseCalendarVisible}}"
        max-date="{{stamp}}"
        min-date="{{stamp - 1000 * 60 * 60 * 24 * 365}}"
        bind:close="hidelicenseCalendar"
        bind:confirm="onLicenseDateChange"
    />
    <ipms-calendar
        show="{{accinateCalendarVisible}}"
        max-date="{{stamp}}"
        min-date="{{stamp - 1000 * 60 * 60 * 24 * 365}}"
        bind:close="hideVaccinateCalendar"
        bind:confirm="onVaccinateDateChange"
    />
</view>
