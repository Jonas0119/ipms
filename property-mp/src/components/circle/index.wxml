<wxs src="../wxs/utils.wxs" module="utils" />

<view class="ipms-circle">
    <canvas
        class="ipms-circle__canvas"
        type="{{ type }}"
        style="width: {{ utils.addUnit(size) }};height:{{ utils.addUnit(size) }}"
        id="ipms-circle"
        canvas-id="ipms-circle"
    ></canvas>
    <view wx:if="{{ !text }}" class="ipms-circle__text">
        <slot></slot>
    </view>
    <cover-view wx:else class="ipms-circle__text">{{ text }}</cover-view>
</view>
