<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />

<ipms-transition
    name="slide-down"
    show="{{ show }}"
    custom-class="ipms-notify__container"
    custom-style="{{ computed.rootStyle({ zIndex, top }) }}"
    bind:tap="onTap"
>
    <view wx:if="{{ customNavBar }}" style="height: {{ offsetTop }}px" />
    <view class="ipms-notify ipms-notify--{{ type }}" style="{{ computed.notifyStyle({ background, color }) }}">
        <text>{{ message }}</text>
    </view>
</ipms-transition>
