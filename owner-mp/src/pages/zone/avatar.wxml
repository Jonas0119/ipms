<view class="container">
    <ipms-image-cropper
        id="ipms-image-cropper"
        limit_move="{{true}}"
        disable_rotate="{{true}}"
        disable_ratio="{{true}}"
        width="{{200}}"
        height="{{200}}"
        min_width="{{100}}"
        min_height="{{100}}"
        export_scale="{{1}}"
        bindload="cropperload"
        bindimageload="loadimage"
        bindtapcut="clickcut"
    />
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
