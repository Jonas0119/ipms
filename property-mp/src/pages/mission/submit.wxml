<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-cell-group wx:if="{{fetching}}">
        <ipms-cell is-detail title="巡检位置：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="是否正常：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="巡检备注：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="现场图片：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <view wx:if="{{error}}" class="result error">
            <ipms-icon name="fail" custom-class="icon" />
            <view class="message">{{ errorMsg }}</view>
            <navigator url="/pages/home/index">返回首页</navigator>
        </view>
        <view wx:elif="{{finish}}" class="result success">
            <ipms-icon name="success" custom-class="icon" />
            <view class="message">巡检已完成</view>
            <navigator url="/pages/home/index">返回首页</navigator>
        </view>
        <ipms-cell-group wx:else>
            <ipms-cell title="巡检位置：" value="{{detail.lineInfo[step].local}}" is-detail />
            <ipms-cell title="巡检进度：" value="{{step + 1}}/{{detail.lineInfo.length}}" is-detail />
            <ipms-cell title="是否正常：">
                <ipms-switch
                    active-value="{{1}}"
                    inactive-value="{{0}}"
                    checked="{{normal}}"
                    bind:change="onNormalChange"
                />
            </ipms-cell>
            <ipms-field
                label="巡检备注："
                type="textarea"
                maxlength="{{ 256 }}"
                show-word-limit
                autosize
                model:value="{{ remark }}"
                placeholder="请输入巡检备注"
            />
            <ipms-cell title="现场照片" border="{{ false }}">
                <ipms-uploader
                    file-list="{{uploadImgList}}"
                    bind:delete="deleteImg"
                    bind:after-read="afterRead"
                    max-count="{{3}}"
                />
            </ipms-cell>

            <ipms-button custom-class="btn" block loading="{{submiting}}" type="info" bind:click="submit">
                上报巡检结果
            </ipms-button>
        </ipms-cell-group>
    </view>

    <ipms-copyright />

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
    <ipms-toast id="ipms-toast" />
</view>
