<wxs src="../wxs/utils.wxs" module="utils" />

<view class="ipms-submit-bar custom-class">
    <slot name="top" />

    <view class="ipms-submit-bar__tip">
        <ipms-icon wx:if="{{ tipIcon }}" size="12px" name="{{ tipIcon }}" custom-class="ipms-submit-bar__tip-icon" />
        <view wx:if="{{ hasTip }}" class="ipms-submit-bar__tip-text">
            {{ tip }}
        </view>
        <slot name="tip" />
    </view>

    <view class="bar-class ipms-submit-bar__bar">
        <slot />
        <view wx:if="{{ hasPrice }}" class="ipms-submit-bar__text">
            <text>{{ label || '合计：' }}</text>
            <text class="ipms-submit-bar__price price-class">
                <text class="ipms-submit-bar__currency">{{ currency }}</text>
                <text class="ipms-submit-bar__price-integer">{{ integerStr }}</text>
                <text>{{decimalStr}}</text>
            </text>
            <text class="ipms-submit-bar__suffix-label">{{ suffixLabel }}</text>
        </view>
        <ipms-button
            round
            type="{{ buttonType }}"
            loading="{{ loading }}"
            disabled="{{ disabled }}"
            class="ipms-submit-bar__button"
            custom-class="button-class"
            custom-style="width: 100%;"
            bind:click="onSubmit"
        >
            {{ loading ? '' : buttonText }}
        </ipms-button>
    </view>

    <view wx:if="{{ safeAreaInsetBottom }}" class="ipms-submit-bar__safe" />
</view>
