<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-cell-group title="报销详细" wx:if="{{fetching}}">
        <ipms-cell is-detail title="流程编号：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请人：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报销时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报销金额：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报销原因：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请结果：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="报销详细">
            <ipms-cell
                is-detail
                title="流程编号："
                value="{{common.number('RF', detail.info.created_at, detail.info.id)}}"
            />
            <ipms-cell
                is-detail
                title="申请人："
                is-link
                wx:if="{{detail.info.created_by !== userInfo.id}}"
                url="/pages/colleague/detail?id={{detail.info.created_by}}"
                clickable
                value="{{detail.info.real_name}}"
            />
            <ipms-cell
                is-detail
                title="报销时间："
                value="{{common.date(detail.info.begin_date, false)}}至{{common.date(detail.info.finish_date, false)}}"
            />
            <ipms-cell is-detail title="报销金额：" value="{{detail.info.total}}元" />
            <ipms-cell is-detail title="报销原因：" value="{{detail.info.reason}}" />
            <ipms-cell is-detail title="申请时间：" value="{{common.date(detail.info.created_at)}}" />
            <ipms-cell is-detail title="申请结果：" border="{{detail.canceled_at ? true : false}}">
                <block wx:if="{{detail.info.cancel}}">
                    <ipms-tag round color="#ff976a">已撤销</ipms-tag>
                </block>
                <block wx:elif="{{detail.info.success === null}}">
                    <ipms-tag round color="#91d5ff">审批中</ipms-tag>
                </block>
                <block wx:elif="{{!detail.info.success}}">
                    <ipms-tag round color="#ed4014">驳回</ipms-tag>
                </block>
                <block wx:else>
                    <ipms-tag round color="#52c41a">成功</ipms-tag>
                </block>
            </ipms-cell>
            <ipms-cell
                is-detail
                title="撤销时间："
                wx:if="{{detail.info.cancel}}"
                border="{{false}}"
                value="{{common.date(detail.info.canceled_at)}}"
            />
        </ipms-cell-group>

        <ipms-cell-group title="报销项目">
            <ipms-collapse value="{{ activeCollapse }}" bind:change="onCollapseChange">
                <ipms-collapse-item
                    wx:for="{{detail.items}}"
                    title="项目{{index + 1}}（{{item.fee}}元）"
                    wx:key="index"
                    name="{{index}}"
                >
                    <view class="row">
                        <view class="label">花销用途：</view>
                        {{item.reason}}
                    </view>
                    <view class="row">
                        <view class="label">发票代码：</view>
                        {{item.code}}
                    </view>
                    <view class="row">
                        <view class="label">发票号码：</view>
                        {{item.num}}
                    </view>
                    <view class="row">
                        <view class="label">开票日期：</view>
                        {{common.date(item.date, false)}}
                    </view>
                    <view class="row">
                        <view class="label">报销金额：</view>
                        {{item.fee}}元
                    </view>
                    <view class="row">
                        <view class="label">电子发票：</view>
                        <ipms-image
                            src="{{ASSETS_HOST}}{{item.attachment_url}}"
                            data-src="{{ASSETS_HOST}}{{item.attachment_url}}"
                            width="80px"
                            height="80px"
                            bind:click="showImg"
                        />
                    </view>
                </ipms-collapse-item>
            </ipms-collapse>
        </ipms-cell-group>

        <view
            class="cancel-btn-box"
            wx:if="{{!detail.info.cancel && detail.info.success === null && detail.info.created_by === userInfo.id}}"
        >
            <ipms-button custom-class="cancel-btn" block type="warning" loading="{{canceling}}" bind:click="doCancel">
                撤销申请
            </ipms-button>
        </view>

        <ipms-cell-group title="审批流程">
            <ipms-workflow
                steps="{{detail.steps}}"
                info="{{detail.info}}"
                label="报销金额"
                userId="{{userInfo.id}}"
                bind:approved="onApproved"
                bind:relationed="onRelationed"
            />
        </ipms-cell-group>
    </view>

    <ipms-copyright />

    <!-- 全局提示 -->
    <ipms-dialog id="ipms-dialog" />
    <ipms-notify id="ipms-notify" />
    <ipms-toast id="ipms-toast" />
</view>
