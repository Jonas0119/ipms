<wxs src="../common/common.wxs" module="common" />
<wxs src="./index.wxs" module="complain" />

<view class="container">
    <ipms-steps steps="{{steps}}" active="{{detail.info.step - 1}}" />

    <ipms-cell-group title="反馈信息" wx:if="{{fetching}}">
        <ipms-cell is-detail title="工单号码：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="反馈小区：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="工单来源：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="反馈类型：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="反馈分类：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="问题描述：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="现场图片：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="反馈时间：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="工单完成确认" wx:if="{{detail.info.step === 3}}">
            <ipms-field
                label="反馈信息："
                type="textarea"
                maxlength="{{ 200 }}"
                show-word-limit
                autosize
                model:value="{{ dispose_content }}"
                placeholder="请输入反馈信息"
            />
            <ipms-cell title="现场照片" border="{{ false }}">
                <ipms-uploader
                    file-list="{{uploadImgList}}"
                    bind:delete="deleteImg"
                    bind:after-read="afterRead"
                    max-count="3"
                />
            </ipms-cell>
            <ipms-cell is-detail>
                <ipms-button size="small" type="info" bind:click="finishSubmit" loading="{{submiting}}">
                    确认完成
                </ipms-button>
            </ipms-cell>
        </ipms-cell-group>

        <ipms-cell-group title="工单确认" wx:if="{{detail.info.step === 2}}">
            <ipms-field
                label="接单回复："
                type="textarea"
                maxlength="{{ 200 }}"
                show-word-limit
                autosize
                model:value="{{ dispose_reply }}"
                placeholder="请输入回复内容"
            />
            <ipms-cell is-detail>
                <ipms-button size="small" type="info" bind:click="confirmSubmit" loading="{{submiting}}">
                    确认工单
                </ipms-button>
            </ipms-cell>
        </ipms-cell-group>

        <ipms-cell-group title="反馈回复" wx:if="{{detail.info.step === 4}}">
            <ipms-cell is-detail title="反馈信息：" value="{{ detail.info.dispose_content || '无内容' }}" />
            <ipms-cell is-detail title="现场图片：">
                <ipms-image
                    wx:for="{{detail.info.dispose_imgs}}"
                    wx:key="index"
                    src="{{ASSETS_HOST}}{{item}}"
                    width="80px"
                    height="80px"
                    custom-class="pre-img"
                    data-index="{{index}}"
                    bind:click="showDisposeImg"
                />
                <view wx:if="{{detail.info.dispose_imgs.length === 0}}" class="text-lighter">您未提供照片</view>
            </ipms-cell>
            <ipms-cell
                is-detail
                title="工单完成时间："
                border="{{false}}"
                value="{{common.date(detail.info.finished_at)}}"
            />
        </ipms-cell-group>

        <ipms-cell-group title="派单确认" wx:if="{{detail.info.step >= 3}}">
            <ipms-cell is-detail title="您的回复：" value="{{ detail.info.dispose_reply || '-' }}" />
            <ipms-cell is-detail title="确认时间：" border="{{false}}" value="{{common.date(detail.info.disposed_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="反馈受理" wx:if="{{detail.info.step >= 2}}">
            <ipms-cell
                is-detail
                title="派单人员："
                border="{{false}}"
                is-link
                url="/pages/colleague/detail?id={{detail.allotInfo.id}}"
                clickable
                value="{{detail.allotInfo.real_name}}"
            />
        </ipms-cell-group>

        <ipms-cell-group title="反馈信息">
            <ipms-cell
                is-detail
                title="工单号码："
                value="{{common.number('C', detail.info.created_at, detail.info.id)}}"
            />
            <ipms-cell is-detail title="反馈小区：">
                <span
                    wx:for="{{postInfo.community_list}}"
                    wx:key="index"
                    wx:if="{{item.community_id === postInfo.default_community_id}}"
                >
                    {{ item.name }}
                </span>
            </ipms-cell>
            <ipms-cell is-detail title="工单来源：" value="{{detail.info.refer === 'ower' ? '业主报修' : '公司指派'}}" />
            <ipms-cell
                is-detail
                title="业主信息："
                is-link
                wx:if="{{common.haveAccess(userInfo.access, ROLES.YZDA) && detail.info.refer === 'ower'}}"
                url="/pages/ower/detail?id={{detail.referInfo.id}}"
                clickable
                value="{{detail.referInfo.real_name}}"
            />
            <ipms-cell is-detail title="反馈类型：" value="{{detail.info.type === 1 ? '投诉' : '建议'}}" />
            <ipms-cell is-detail title="反馈分类：" value="{{complain.categoryName(detail.info.category)}}" />
            <ipms-cell is-detail title="问题描述：" value="{{detail.info.description}}" />
            <ipms-cell is-detail title="现场图片：">
                <ipms-image
                    wx:for="{{detail.info.complain_imgs}}"
                    wx:key="index"
                    src="{{ASSETS_HOST}}{{item}}"
                    width="80px"
                    height="80px"
                    custom-class="pre-img"
                    data-index="{{index}}"
                    bind:click="showComplainImg"
                />
                <view wx:if="{{detail.info.complain_imgs.length === 0}}" class="text-lighter">业主未提供</view>
            </ipms-cell>
            <ipms-cell is-detail title="反馈时间：" border="{{false}}" value="{{common.date(detail.info.created_at)}}" />
        </ipms-cell-group>
    </view>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
