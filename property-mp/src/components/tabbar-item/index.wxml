<wxs src="../wxs/utils.wxs" module="utils" />

<view
    class="{{ utils.bem('tabbar-item', { active }) }} custom-class"
    style="color: {{ active ? activeColor : inactiveColor }}"
    bindtap="onClick"
>
    <view class="ipms-tabbar-item__icon">
        <ipms-icon
            wx:if="{{ icon }}"
            name="{{ icon }}"
            class-prefix="{{ iconPrefix }}"
            custom-class="ipms-tabbar-item__icon__inner"
        />
        <block wx:else>
            <slot wx:if="{{ active }}" name="icon-active" />
            <slot wx:else name="icon" />
        </block>
        <ipms-info dot="{{ dot }}" info="{{ info }}" custom-class="ipms-tabbar-item__info" />
    </view>
    <view class="ipms-tabbar-item__text">
        <slot />
    </view>
</view>
