@import '../common/index.wxss';

.ipms-button {
    position: relative;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0;
    text-align: center;
    vertical-align: middle;
    -webkit-appearance: none;
    -webkit-text-size-adjust: 100%;
    height: 44px;
    line-height: 20px;
    font-size: 16px;
    transition: opacity 0.2s;
    border-radius: 2px;
}

.ipms-button:before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border: inherit;
    border-radius: inherit;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    opacity: 0;
    content: ' ';
    background-color: #000;
    border-color: #000;
}

.ipms-button:after {
    border-width: 0;
}

.ipms-button--active:before {
    opacity: 0.15;
}

.ipms-button--unclickable:after {
    display: none;
}

.ipms-button--default {
    color: #323233;
    background: #fff;
    border: 1px solid #ebedf0;
}

.ipms-button--primary {
    color: #fff;
    background: #07c160;
    border: 1px solid #07c160;
}

.ipms-button--info {
    color: #fff;
    background: #1989fa;
    border: 1px solid #1989fa;
}

.ipms-button--danger {
    color: #fff;
    background: #ee0a24;
    border: 1px solid #ee0a24;
}

.ipms-button--warning {
    color: #fff;
    background: #ff976a;
    border: 1px solid #ff976a;
}

.ipms-button--plain {
    background: #fff;
}

.ipms-button--plain.ipms-button--primary {
    color: #07c160;
}

.ipms-button--plain.ipms-button--info {
    color: #1989fa;
}

.ipms-button--plain.ipms-button--danger {
    color: #ee0a24;
}

.ipms-button--plain.ipms-button--warning {
    color: #ff976a;
}

.ipms-button--large {
    width: 100%;
    height: 50px;
}

.ipms-button--normal {
    padding: 0 15px;
    font-size: 14px;
}

.ipms-button--small {
    min-width: 60px;
    height: 30px;
    padding: 0 8px;
    font-size: 12px;
}

.ipms-button--mini {
    display: inline-block;
    min-width: 50px;
    height: 22px;
    font-size: 10px;
}

.ipms-button--mini + .ipms-button--mini {
    margin-left: 5px;
}

.ipms-button--block {
    display: -webkit-flex;
    display: flex;
    width: 100%;
}

.ipms-button--round {
    border-radius: 999px;
}

.ipms-button--square {
    border-radius: 0;
}

.ipms-button--disabled {
    opacity: 0.5;
}

.ipms-button__text {
    display: inline;
}

.ipms-button__icon + .ipms-button__text:not(:empty),
.ipms-button__loading-text {
    margin-left: 4px;
}

.ipms-button__icon {
    min-width: 1em;
    line-height: inherit !important;
    vertical-align: top;
}

.ipms-button--hairline {
    padding-top: 1px;
    border-width: 0;
}

.ipms-button--hairline:after {
    border-color: inherit;
    border-width: 1px;
    border-radius: 4px;
}

.ipms-button--hairline.ipms-button--round:after {
    border-radius: 999px;
}

.ipms-button--hairline.ipms-button--square:after {
    border-radius: 0;
}
