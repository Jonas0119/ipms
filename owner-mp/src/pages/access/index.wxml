<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-tabs active="{{ activeTab }}" bind:change="onTabChange" disabled="{{fetching}}">
        <ipms-tab title="门禁卡">
            <ipms-empty
                icon="not-support"
                wx:if="{{!communityInfo.current.access_nfc && !communityInfo.current.access_qrcode}}"
                description="{{communityInfo.current.name}}小区暂不支持联网门禁系统"
                fixed="{{false}}"
            />
            <ipms-empty
                icon="access"
                wx:elif="{{cardList.length === 0}}"
                description="未查询到{{communityInfo.current.name}}小区门禁卡"
                fixed="{{false}}"
            />
            <view wx:else>
                <view wx:if="{{!fetching}}">
                    <navigator
                        wx:for="{{cardList}}"
                        wx:key="index"
                        url="/pages/access/card?uid={{item.uid}}&building_id={{item.building_id}}"
                        class="card"
                    >
                        <image src="../../assets/access/card{{item.building_id % 3}}.jpg" mode="widthFix" class="bg" />

                        <view class="name">{{communityInfo.current.name}}</view>
                        <view
                            wx:for="{{communityInfo.current.houses}}"
                            wx:for-item="row"
                            wx:for-key="key"
                            wx:key="key"
                            wx:if="{{row.building_id === item.building_id}}"
                            class="house"
                        >
                            {{ common.building(row) }}
                        </view>
                    </navigator>
                </view>
                <view wx:else>
                    <view class="card" wx:for="{{2}}" wx:key="key">
                        <view class="name"><ipms-skeleton row="{{1}}" row-width="25%" /></view>
                        <view class="house"><ipms-skeleton row="{{1}}" row-width="42%" /></view>
                    </view>
                </view>
            </view>
        </ipms-tab>
        <ipms-tab title="远程开门">
            <ipms-empty
                fixed="{{false}}"
                icon="not-support"
                description="{{communityInfo.current.name}}小区暂不支持远程开门"
                wx:if="{{!communityInfo.current.access_remote}}"
            />
            <ipms-empty
                icon="access"
                wx:elif="{{entranceList.length === 0}}"
                description="未查询到{{communityInfo.current.name}}小区可远程开门门禁"
                fixed="{{false}}"
            />
            <view wx:else>
                <ipms-cell-group title="可操控智能门禁">
                    <ipms-cell
                        wx:for="{{entranceList}}"
                        wx:key="index"
                        title="{{item.name}}"
                        is-link
                        border="{{index === entranceList.length - 1 ? false : true}}"
                        data-id="{{item.id}}"
                        bind:click="openDoor"
                        clickable
                    />
                </ipms-cell-group>
            </view>
        </ipms-tab>
    </ipms-tabs>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
