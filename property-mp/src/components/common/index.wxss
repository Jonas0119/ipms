.ipms-ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ipms-multi-ellipsis--l2 {
    -webkit-line-clamp: 2;
}

.ipms-multi-ellipsis--l2,
.ipms-multi-ellipsis--l3 {
    display: -webkit-box;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
}

.ipms-multi-ellipsis--l3 {
    -webkit-line-clamp: 3;
}

.ipms-clearfix:after {
    display: table;
    clear: both;
    content: '';
}

.ipms-hairline,
.ipms-hairline--bottom,
.ipms-hairline--left,
.ipms-hairline--right,
.ipms-hairline--surround,
.ipms-hairline--top,
.ipms-hairline--top-bottom {
    position: relative;
}

.ipms-hairline--bottom:after,
.ipms-hairline--left:after,
.ipms-hairline--right:after,
.ipms-hairline--surround:after,
.ipms-hairline--top-bottom:after,
.ipms-hairline--top:after,
.ipms-hairline:after {
    position: absolute;
    box-sizing: border-box;
    -webkit-transform-origin: center;
    transform-origin: center;
    content: ' ';
    pointer-events: none;
    top: -50%;
    right: -50%;
    bottom: -50%;
    left: -50%;
    border: 0 solid #ebedf0;
    -webkit-transform: scale(0.5);
    transform: scale(0.5);
}

.ipms-hairline--top:after {
    border-top-width: 1px;
}

.ipms-hairline--left:after {
    border-left-width: 1px;
}

.ipms-hairline--right:after {
    border-right-width: 1px;
}

.ipms-hairline--bottom:after {
    border-bottom-width: 1px;
}

.ipms-hairline--top-bottom:after {
    border-width: 1px 0;
}

.ipms-hairline--surround:after {
    border-width: 1px;
}
