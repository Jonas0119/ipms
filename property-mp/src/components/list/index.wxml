<view class="ipms-list {{withFilter ? 'with-filter' : ''}} {{inTabPage ? 'in-tab-page' : ''}}">
    <slot />

    <view class="ipms-list-loading-item" wx:if="{{fetching && page_num === 1}}" wx:for="{{page_size}}" wx:key="num">
        <view class="ipms-list-loading-item-header">
            <ipms-skeleton row="{{ 1 }}" solt="title" row-width="40%" />
        </view>
        <ipms-skeleton row="{{ 3 }}" title />
    </view>

    <ipms-divider wx:if="{{ page_num >= page_amount && !fetching && list.length > 0 }}" contentPosition="center">
        只有这些数据了
    </ipms-divider>

    <!-- 加载状态 -->
    <view wx:if="{{ fetching && page_num > 1 }}" class="ipms-list-load-more">
        <ipms-loading>加载中...</ipms-loading>
    </view>

    <ipms-empty
        fixed="{{fixed}}"
        description="{{empty}}"
        icon="{{icon}}"
        with-copyright
        wx:if="{{!fetching && list.length === 0}}"
    >
        <view wx:if="{{useEmptySlot}}">
            <slot name="empty" />
        </view>
    </ipms-empty>

    <ipms-copyright wx:if="{{!fetching && list.length === 0}}" inTabPage="{{inTabPage}}" fixed="{{ fixed }}" />
</view>
