<ipms-overlay
    wx:if="{{ mask || forbidClick }}"
    show="{{ show }}"
    z-index="{{ zIndex }}"
    custom-style="{{ mask ? '' : 'background-color: transparent;' }}"
/>
<ipms-transition show="{{ show }}" custom-style="z-index: {{ zIndex }}" custom-class="ipms-toast__container">
    <view
        class="ipms-toast ipms-toast--{{ type === 'text' ? 'text' : 'icon' }} ipms-toast--{{ position }}"
        catch:touchmove="noop"
    >
        <!-- text only -->
        <text wx:if="{{ type === 'text' }}">{{ message }}</text>

        <!-- with icon -->
        <block wx:else>
            <ipms-loading
                wx:if="{{ type === 'loading' }}"
                color="white"
                type="{{ loadingType }}"
                custom-class="ipms-toast__loading"
            />
            <ipms-icon wx:else class="ipms-toast__icon" name="{{ type }}" />
            <text wx:if="{{ message }}" class="ipms-toast__text">{{ message }}</text>
        </block>

        <slot />
    </view>
</ipms-transition>
