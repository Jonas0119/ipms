<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-list
        fetching="{{fetching}}"
        page_num="{{page_num}}"
        page_amount="{{page_amount}}"
        list="{{list}}"
        empty="暂无装修验收"
        icon="fitment"
    >
        <ipms-list-item
            wx:for="{{list}}"
            title="{{common.number('F', item.created_at, item.id)}}"
            wx:key="index"
            useFooterSlot="{{item.step === 3 ? true : false}}"
        >
            <ipms-list-item-info label="装修位置">
                {{ common.building(item) }}
            </ipms-list-item-info>
            <ipms-list-item-info label="申请时间">
                {{ common.date(item.created_at) }}
            </ipms-list-item-info>

            <view slot="footer">
                <ipms-button size="small" round type="primary" data-id="{{item.id}}" bind:click="finish">
                    验收完成
                </ipms-button>
            </view>
        </ipms-list-item>
    </ipms-list>

    <ipms-dialog id="ipms-dialog" />

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
    <ipms-toast id="ipms-toast" />
</view>
