<wxs src="../wxs/utils.wxs" module="utils" />

<view class="custom-class ipms-card">
    <view class="{{ utils.bem('card__header', { center: centered }) }}">
        <view class="ipms-card__thumb" bind:tap="onClickThumb">
            <image
                wx:if="{{ thumb }}"
                src="{{ thumb }}"
                mode="{{ thumbMode }}"
                lazy-load="{{ lazyLoad }}"
                class="ipms-card__img thumb-class"
            />
            <slot wx:else name="thumb" />
            <ipms-tag wx:if="{{ tag }}" mark type="danger" custom-class="ipms-card__tag">
                {{ tag }}
            </ipms-tag>
            <slot wx:else name="tag" />
        </view>

        <view class="ipms-card__content {{ utils.bem('card__content', { center: centered }) }}">
            <view>
                <view wx:if="{{ title }}" class="ipms-card__title title-class">{{ title }}</view>
                <slot wx:else name="title" />

                <view wx:if="{{ desc }}" class="ipms-card__desc desc-class">{{ desc }}</view>
                <slot wx:else name="desc" />

                <slot name="tags" />
            </view>

            <view class="ipms-card__bottom">
                <slot name="price-top" />
                <view wx:if="{{ price || price === 0 }}" class="ipms-card__price price-class">
                    <text>{{ currency }}</text>
                    <text class="ipms-card__price-integer">{{ integerStr }}</text>
                    <text class="ipms-card__price-decimal">{{ decimalStr }}</text>
                </view>
                <slot wx:else name="price" />
                <view wx:if="{{ originPrice || originPrice === 0 }}" class="ipms-card__origin-price origin-price-class">
                    {{ currency }} {{ originPrice }}
                </view>
                <slot wx:else name="origin-price" />
                <view wx:if="{{ num }}" class="ipms-card__num num-class">x {{ num }}</view>
                <slot wx:else name="num" />
                <slot name="bottom" />
            </view>
        </view>
    </view>

    <view class="ipms-card__footer">
        <slot name="footer" />
    </view>
</view>
