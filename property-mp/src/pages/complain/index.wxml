<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-dropdown-menu>
        <ipms-dropdown-item bind:change="onStatusChange" value="{{ status }}" options="{{ statusOptions }}" />
    </ipms-dropdown-menu>

    <ipms-list
        fetching="{{fetching}}"
        page_num="{{page_num}}"
        page_amount="{{page_amount}}"
        list="{{list}}"
        empty="暂无投诉工单"
        icon="report"
        withFilter
    >
        <ipms-list-item
            wx:for="{{list}}"
            url="/pages/complain/detail?id={{item.id}}"
            title="{{common.number('C', item.created_at, item.id)}}"
            wx:key="index"
        >
            <ipms-list-item-info label="反馈类型">
                <block wx:if="{{item.category === 1}}">
                    卫生
                </block>
                <block wx:elif="{{item.category === 2}}">
                    噪音
                </block>
                <block wx:elif="{{item.category === 3}}">
                    服务态度
                </block>
                <block wx:elif="{{item.category === 4}}">
                    违建
                </block>
                <block wx:elif="{{item.category === 5}}">
                    占用消防通道
                </block>
                <block wx:elif="{{item.category === 6}}">
                    小区设施
                </block>
                <block wx:elif="{{item.category === 7}}">
                    其他
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="问题描述">
                {{ item.description }}
            </ipms-list-item-info>
            <ipms-list-item-info label="当前进度">
                <block wx:if="{{item.step === 2}}">
                    <ipms-tag round color="#eb2f96">待确认工单</ipms-tag>
                </block>
                <block wx:elif="{{item.step === 3}}">
                    <ipms-tag round color="#ffe58f">待工单完成</ipms-tag>
                </block>
                <block wx:elif="{{item.step === 4}}">
                    <ipms-tag round color="#52c41a">工单已完成</ipms-tag>
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="反馈时间">
                {{ common.date(item.created_at) }}
            </ipms-list-item-info>
        </ipms-list-item>
    </ipms-list>

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
</view>
