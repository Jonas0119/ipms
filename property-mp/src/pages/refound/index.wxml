<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-tabs active="{{ activeTabIndex }}" bind:change="onTabChange">
        <ipms-tab title="报销申请">
            <ipms-cell-group>
                <ipms-cell
                    title="报销时间"
                    value="{{range.length === 0 ? '请选择报销时间' : common.date(range[0], false) + '至' + common.date(range[1], false)}}"
                    is-link
                    clickable
                    is-detail="{{begin_date ? true : false}}"
                    bind:click="showCalendar"
                />
                <ipms-cell title="报销金额" is-detail value="{{total}}" />
                <ipms-field
                    label="报销原因"
                    type="textarea"
                    maxlength="{{ 128 }}"
                    show-word-limit
                    autosize
                    border="{{false}}"
                    model:value="{{ reason }}"
                    placeholder="请输入报销原因"
                />
            </ipms-cell-group>

            <ipms-cell-group title="报销项目" wx:if="{{items.length}}">
                <ipms-collapse value="{{ activeCollapse }}" bind:change="onCollapseChange">
                    <ipms-collapse-item
                        wx:for="{{items}}"
                        title="项目{{index + 1}}（{{item.fee}}元）"
                        wx:key="index"
                        name="{{index}}"
                    >
                        <view class="row">
                            <view class="label">花销用途：</view>
                            {{item.reason}}
                        </view>
                        <view class="row">
                            <view class="label">发票代码：</view>
                            {{item.code}}
                        </view>
                        <view class="row">
                            <view class="label">发票号码：</view>
                            {{item.num}}
                        </view>
                        <view class="row">
                            <view class="label">开票日期：</view>
                            {{common.date(item.date, false)}}
                        </view>
                        <view class="row">
                            <view class="label">报销金额：</view>
                            {{item.fee}}元
                        </view>
                        <view class="row">
                            <view class="label">电子发票：</view>
                            <ipms-image
                                src="{{ASSETS_HOST}}{{item.attachment_url}}"
                                data-src="{{ASSETS_HOST}}{{item.attachment_url}}"
                                width="80px"
                                height="80px"
                                bind:click="showImg"
                            />
                        </view>
                        <view class="footer">
                            <ipms-button size="small" round type="danger" data-index="{{index}}" bind:click="remove">
                                删除
                            </ipms-button>
                            <ipms-button
                                size="small"
                                custom-class="btn-ml"
                                round
                                type="info"
                                data-index="{{index}}"
                                bind:click="update"
                            >
                                修改
                            </ipms-button>
                        </view>
                    </ipms-collapse-item>
                </ipms-collapse>
            </ipms-cell-group>

            <view class="append-btn-box">
                <ipms-button block round bind:click="appendItem">添加报销项目</ipms-button>
            </view>

            <ipms-calendar
                title="费用产生时间"
                type="range"
                default-date="{{range}}"
                show="{{show}}"
                min-date="{{now - 1000 * 60 * 60 * 24 * 180}}"
                max-date="{{now}}"
                bind:close="hideCalendar"
                bind:confirm="onDateChange"
            />

            <ipms-button
                custom-class="btn"
                block
                wx:if="{{activeTabIndex === 0}}"
                loading="{{submiting}}"
                type="info"
                bind:click="submit"
            >
                提交申请
            </ipms-button>

            <ipms-copyright />
        </ipms-tab>

        <ipms-tab title="历史申请">
            <ipms-list
                fetching="{{fetching}}"
                page_num="{{page_num}}"
                page_amount="{{page_size}}"
                list="{{list}}"
                empty="暂无报销申请"
                icon="refound"
                withFilter
            >
                <ipms-list-item
                    wx:for="{{list}}"
                    title="{{common.number('RF', item.created_at, item.id)}}"
                    wx:key="index"
                    url="/pages/refound/detail?id={{item.id}}"
                >
                    <ipms-list-item-info label="报销时间">
                        {{ common.date(item.begin_date, false) }}至{{ common.date(item.finish_date, false) }}
                    </ipms-list-item-info>
                    <ipms-list-item-info label="报销金额">
                        {{ item.total }}元
                    </ipms-list-item-info>
                    <ipms-list-item-info label="报销原因">
                        {{ item.reason }}
                    </ipms-list-item-info>
                    <ipms-list-item-info label="申请结果">
                        <block wx:if="{{item.cancel}}">
                            <ipms-tag round color="#ff976a">已取消</ipms-tag>
                        </block>
                        <block wx:elif="{{item.success === null}}">
                            <ipms-tag round color="#91d5ff">审批中</ipms-tag>
                        </block>
                        <block wx:elif="{{!item.success}}">
                            <ipms-tag round color="#ed4014">驳回</ipms-tag>
                        </block>
                        <block wx:else>
                            <ipms-tag round color="#52c41a">成功</ipms-tag>
                        </block>
                    </ipms-list-item-info>
                    <ipms-list-item-info label="申请时间">
                        {{ common.date(item.created_at) }}
                    </ipms-list-item-info>
                </ipms-list-item>
            </ipms-list>
        </ipms-tab>
    </ipms-tabs>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
