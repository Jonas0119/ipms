<view class="container" style="padding-top:{{ systemInfo.navBarHeight + systemInfo.statusBarHeight }}px">
    <ipms-nav-bar
        title="IPMS物业端"
        fixed
        title-class="nav-bar-title"
        z-index="100"
        custom-class="nav-bar"
        custom-style="height:{{ systemInfo.navBarHeight + systemInfo.statusBarHeight }}px;padding-top:{{ systemInfo.statusBarHeight }}px"
    >
        <view slot="left" class="default-community" bind:tap="changeCommunity">
            <ipms-icon name="local" />
            <span
                wx:for="{{postInfo.community_list}}"
                wx:key="index"
                wx:if="{{item.community_id === postInfo.default_community_id}}"
            >
                {{ item.name }}
            </span>
        </view>
    </ipms-nav-bar>

    

    <ipms-panel title="我的任务">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <navigator class="feature" url="/pages/repair/index">
                    <ipms-icon name="maintain" custom-class="icon repair" info="{{workInfo.repair_total}}" />
                    <view class="label">维修工单</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/complain/index">
                    <ipms-icon name="report" custom-class="icon complain" info="{{workInfo.complain_total}}" />
                    <view class="label">投诉工单</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/mission/index">
                    <ipms-icon name="mission" custom-class="icon mission" info="{{workInfo.mission_total}}" />
                    <view class="label">巡检任务</view>
                </navigator>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <view wx:if="{{ !userInfo.subscribed && showOaComponent }}" class="section official-account">
        <view class="recommand">关注官方公众号第一时间接收重要消息</view>
        <official-account binderror="onOALoadFail" />
    </view>

    <ipms-panel title="小区服务" custom-class="section">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <view class="feature" bind:tap="owerScan">
                    <ipms-icon name="ower" custom-class="icon ower" />
                    <view class="label">业主核实</view>
                </view>
            </ipms-col>
            <ipms-col span="6" wx:if="{{!common.haveAccess(userInfo.access, ROLES.FKTX)}}">
                <view class="feature" bind:tap="vistorScan">
                    <ipms-icon name="vistor" custom-class="icon vistor" />
                    <view class="label">访客认证</view>
                </view>
            </ipms-col>
            <ipms-col span="6" wx:if="{{!common.haveAccess(userInfo.access, ROLES.ZXDJ)}}">
                <navigator class="feature" url="/pages/fitment/index">
                    <ipms-icon name="fitment" custom-class="icon fitment" />
                    <view class="label">装修验收</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6" wx:if="{{!common.haveAccess(userInfo.access, ROLES.XQNC)}}">
                <navigator class="feature" url="/pages/move_car/index">
                    <ipms-icon name="movecar" custom-class="icon movecar" />
                    <view class="label">现场挪车</view>
                </navigator>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <ipms-panel title="信息建设" custom-class="section">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <navigator class="feature" url="/pages/party/index">
                    <ipms-icon name="party" custom-class="icon party" info="{{workInfo.party.length}}" />
                    <view class="label">党建党讯</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/inform/index">
                    <ipms-icon name="inform" custom-class="icon inform" info="{{workInfo.inform.length}}" />
                    <view class="label">行政通知</view>
                </navigator>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <ipms-panel title="行政事务" custom-class="section">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <navigator class="feature" url="/pages/meeting/index">
                    <ipms-icon name="meeting" custom-class="icon meeting" info="{{workInfo.meeting.length}}" />
                    <view class="label">会议安排</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/sign/begin">
                    <ipms-icon name="gotowork" custom-class="icon gotowork" />
                    <view class="label">上班打卡</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/sign/finish">
                    <ipms-icon name="gotohome" custom-class="icon gotohome" />
                    <view class="label">下班打卡</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/colleague/index">
                    <ipms-icon name="connect" custom-class="icon connect" />
                    <view class="label">通讯录</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6" wx:if="{{!common.haveAccess(userInfo.access, ROLES.WLCC)}}">
                <view class="feature" bind:tap="scanMaterial">
                    <ipms-icon name="warehouse" custom-class="icon warehouse" />
                    <view class="label">物品领用</view>
                </view>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <ipms-panel title="流程审批" custom-class="section">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <navigator class="feature" url="/pages/leave/approve">
                    <ipms-icon name="leave" custom-class="icon leave" info="{{workInfo.leave_total}}" />
                    <view class="label">请假审批</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/refound/approve">
                    <ipms-icon name="refound" custom-class="icon refound" info="{{workInfo.refound_total}}" />
                    <view class="label">报销审批</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/purchase/approve">
                    <ipms-icon name="warehouse" custom-class="icon purchase" info="{{workInfo.purchase_total}}" />
                    <view class="label">采购审批</view>
                </navigator>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <ipms-panel title="流程申请" custom-class="section">
        <ipms-row custom-class="links">
            <ipms-col span="6">
                <navigator class="feature" url="/pages/leave/index">
                    <ipms-icon name="leave" custom-class="icon leave-apply" />
                    <view class="label">请假申请</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/refound/index">
                    <ipms-icon name="refound" custom-class="icon refound-apply" />
                    <view class="label">报销申请</view>
                </navigator>
            </ipms-col>
            <ipms-col span="6">
                <navigator class="feature" url="/pages/purchase/index">
                    <ipms-icon name="warehouse" custom-class="icon purchase-apply" />
                    <view class="label">采购申请</view>
                </navigator>
            </ipms-col>
        </ipms-row>
    </ipms-panel>

    <ipms-copyright />

    <ipms-action-sheet
        title="设置默认小区"
        show="{{ showAction }}"
        actions="{{ actions }}"
        bind:close="onCloseAction"
        bind:select="onSelectAction"
    />
    <!-- 全局提示 -->
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
