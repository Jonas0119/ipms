<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-list
        fetching="{{fetching}}"
        page_num="{{page_num}}"
        page_amount="{{page_amount}}"
        list="{{list}}"
        empty="暂无申请认证记录"
    >
        <ipms-list-item wx:for="{{list}}" title="{{common.number('A', item.created_at, item.id)}}" wx:key="index">
            <ipms-list-item-info label="申请小区">
                {{item.community_name}}
            </ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.house}}" label="住宅信息">
                {{item.house}}
            </ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.carport}}" label="车位信息">{{item.carport}}</ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.warehouse}}" label="仓房信息">{{item.warehouse}}</ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.community_id}}" label="认证进度">
                <block wx:if="{{!item.replied}}">
                    <ipms-tag round color="#13c2c2">待认证</ipms-tag>
                </block>
                <block wx:elif="{{item.success}}">
                    <ipms-tag round type="success">认证成功</ipms-tag>
                </block>
                <block wx:elif="{{!item.success}}">
                    <ipms-tag round type="danger">认证失败</ipms-tag>
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.replied && !item.success && item.community_id}}" label="失败原因">
                {{item.reply_content}}
            </ipms-list-item-info>
            <ipms-list-item-info wx:if="{{item.replied && item.community_id}}" label="认证时间">
                {{common.date(item.replied_at)}}
            </ipms-list-item-info>
            <ipms-list-item-info class="row" label="申请时间">{{common.date(item.created_at)}}</ipms-list-item-info>
            <ipms-list-item-info wx:if="{{!item.community_id}}">因为查询到物业信息或小区信息申请被搁置</ipms-list-item-info>
        </ipms-list-item>
    </ipms-list>
</view>
