<wxs src="../common/common.wxs" module="common" />

<view class="container {{detail.step === 4 ? '' : 'bottom'}}">
    <ipms-notice-bar text="当前工单已被合并，展示的为合并后的工单信息" wx:if="{{detail.merge_id}}" />
    <ipms-steps steps="{{steps}}" active="{{detail.step - 1}}" />

    <ipms-cell-group title="报修信息" wx:if="{{fetching}}">
        <ipms-cell is-detail title="工单号码：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报修小区：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报修位置：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="维修类型：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="问题描述：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="现场图片：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报修时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="请对服务评价" wx:if="{{!detail.merge_id && detail.step === 4 && !detail.rate}}">
            <ipms-cell is-detail title="满意度">
                <ipms-rate value="{{rate}}" bind:change="onRateChange" />
            </ipms-cell>
            <ipms-field
                label="评价"
                type="textarea"
                maxlength="{{ 128 }}"
                show-word-limit
                autosize
                model:value="{{ rate_content }}"
                placeholder="请输入评价"
            />
            <ipms-cell is-detail border="{{false}}">
                <ipms-button size="small" type="info" bind:click="rateSubmit" loading="{{submiting}}">评价</ipms-button>
            </ipms-cell>
        </ipms-cell-group>

        <ipms-cell-group title="业主评价" wx:if="{{!detail.merge_id && detail.step === 4 && detail.rate}}">
            <ipms-cell is-detail title="满意度：">
                <ipms-rate value="{{detail.rate}}" readonly />
            </ipms-cell>
            <ipms-cell is-detail title="评价内容：" value="{{detail.rate_content || '业主未提交评价内容'}}" />
            <ipms-cell is-detail title="评价时间：" border="{{false}}" value="{{common.date(detail.rated_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="维修内容" wx:if="{{detail.step === 4}}">
            <ipms-cell is-detail title="维修详细：" value="{{ detail.dispose_content || '无内容' }}" />
            <ipms-cell is-detail title="现场图片：">
                <ipms-image
                    wx:for="{{detail.dispose_imgs}}"
                    wx:key="index"
                    src="{{item}}"
                    width="80px"
                    height="80px"
                    data-index="{{index}}"
                    bind:click="showDisposeImg"
                />
                <view wx:if="{{detail.dispose_imgs.length === 0}}" class="text-color-light">指派人员未提供</view>
            </ipms-cell>
            <ipms-cell is-detail title="工单完成时间：" border="{{false}}" value="{{common.date(detail.finished_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="派单确认" wx:if="{{detail.step >= 3}}">
            <ipms-cell is-detail title="指派人员回复：" value="{{ detail.dispose_reply || '-' }}" />
            <ipms-cell is-detail title="派单确认时间：" border="{{false}}" value="{{common.date(detail.disposed_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="派单状态" wx:if="{{detail.step >= 2}}">
            <ipms-cell is-detail title="派单人员：">
                <ipms-employee info="{{detail.allotInfo}}" />
            </ipms-cell>
            <ipms-cell
                is-detail
                title="派单人员联系电话："
                is-link
                bind:click="makePhone"
                clickable
                data-phone="{{detail.allotInfo.phone}}"
                value="{{detail.allotInfo.phone}}"
            />
            <ipms-cell is-detail title="指派人员：">
                <ipms-employee info="{{detail.disposedInfo}}" />
            </ipms-cell>
            <ipms-cell
                is-detail
                title="指派人员联系电话："
                is-link
                clickable
                bind:click="makePhone"
                data-phone="{{detail.disposedInfo.phone}}"
                value="{{detail.disposedInfo.phone}}"
            />
            <ipms-cell is-detail title="派单时间：" border="{{false}}" value="{{common.date(detail.alloted_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="报修信息">
            <ipms-cell is-detail title="工单号码：" value="{{common.number('R', detail.created_at, detail.id)}}" />
            <ipms-cell is-detail title="报修小区：" value="{{detail.community_name}}" />
            <ipms-cell is-detail title="报修位置：" wx:if="{{!detail.building_id }}" value="公共区域" />
            <ipms-cell is-detail title="报修位置：" wx:else value="{{ common.building(detail) }}" />
            <ipms-cell
                is-detail
                title="维修类型："
                value="{{detail.repair_type === 1 ? '水暖' : (detail.repair_type === 2 ? '电路' : (detail.repair_type === 3 ? '门窗' : '公共设施'))}}"
            />
            <ipms-cell is-detail title="问题描述：" value="{{detail.description}}" />
            <ipms-cell is-detail title="现场图片：">
                <ipms-image
                    wx:for="{{detail.repair_imgs}}"
                    wx:key="index"
                    src="{{item}}"
                    width="80px"
                    height="80px"
                    data-index="{{index}}"
                    bind:click="showRepairImg"
                />
                <view wx:if="{{detail.repair_imgs.length === 0}}" class="text-color-light">业主未提供</view>
            </ipms-cell>
            <ipms-cell is-detail title="报修时间：" border="{{false}}" value="{{common.date(detail.created_at)}}" />
        </ipms-cell-group>
    </view>

    <ipms-button
        custom-class="btn"
        block
        loading="{{urging}}"
        type="danger"
        bind:click="doUrge"
        wx:if="{{detail.step < 4}}"
    >
        催促工单
    </ipms-button>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
