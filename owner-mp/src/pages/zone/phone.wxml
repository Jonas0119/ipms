 +----------------------------------------------------------------------
-->
<view class="container">
    <view class="identity {{ userInfo.phone ? '' : 'unable' }}">
        <ipms-icon name="identity" />
        <view wx:if="{{userInfo.phone}}" class="num">{{ userInfo.phone }}</view>
    </view>
    <view class="phone {{ userInfo.phone ? '' : 'unable' }}">
        <ipms-tag type="success" size="large" wx:if="{{userInfo.phone}}">手机号码已验证</ipms-tag>
        <ipms-tag type="warning" size="large" wx:else>手机号码未验证</ipms-tag>
    </view>

    <view class="intro">
        <view class="text">物业公司将通过此号码联系你</view>
        <view class="text">我们不会泄露你的隐私数据</view>
        <view class="text">我们只会将手机号码提供给物业公司</view>
    </view>

    <ipms-button
        open-type="getPhoneNumber"
        type="info"
        custom-class="btn"
        wx:if="{{!userInfo.phone}}"
        block
        bind:getphonenumber="bindPhone"
    >
        授权获取你的手机号码
    </ipms-button>
    <ipms-copyright />
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
