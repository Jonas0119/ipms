    <ipms-cell-group>
        <ipms-cell
            title="所在小区"
            title-width="100px"
            value="{{communityInfo.current.name}}小区"
            is-link
            is-detail
            url="/pages/community/index"
        />
        <ipms-cell
            title="挪车原因"
            clickable
            is-link
            is-detail="{{move_reason_text ? true : false}}"
            value="{{move_reason_text ? move_reason_text : '请选择'}}"
            bind:click="showAction"
        />
        <ipms-cell title="是否新能源">
            <ipms-switch bind:change="updateNewEnergy" checked="{{is_new_energy}}" />
        </ipms-cell>
        <ipms-cell custom-class="number-cell">
            <view slot="title">车牌号码</view>
            <ipms-car-number is-new-energy="{{is_new_energy}}" id="car-number" bind:change="onCarNumberChange" />
        </ipms-cell>
        <ipms-cell title="现场照片" border="{{ false }}" title-class="upload-title" value-class="upload-cell">
            <ipms-uploader
                file-list="{{uploadImgList}}"
                bind:delete="deleteImg"
                bind:after-read="afterRead"
                max-count="{{1}}"
            />
        </ipms-cell>
    </ipms-cell-group>

    <ipms-button custom-class="btn" block loading="{{submiting}}" type="info" bind:click="submit">
        立即挪车
    </ipms-button>

    <ipms-action-sheet
        title="挪车原因"
        close-on-click-overlay="{{true}}"
        show="{{actionVisible}}"
        bind:close="hideAction"
        bind:select="onReasonChange"
        actions="{{actions}}"
    />
    <ipms-toast id="ipms-toast" />
    <ipms-dialog id="ipms-dialog" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
