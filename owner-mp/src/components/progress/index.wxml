<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />

<view class="ipms-progress custom-class" style="{{ computed.rootStyle({ strokeWidth, trackColor }) }}">
    <view class="ipms-progress__portion" style="{{ computed.portionStyle({ percentage, inactive, color }) }}">
        <view
            wx:if="{{ showPivot && computed.pivotText(pivotText, percentage) }}"
            style="{{ computed.pivotStyle({ textColor, pivotColor, inactive, color, right }) }}"
            class="ipms-progress__pivot"
        >
            {{ computed.pivotText(pivotText, percentage) }}
        </view>
    </view>
</view>
