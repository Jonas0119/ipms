.container {
    padding: 30rpx;
}

.section {
    margin-bottom: 60rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 2rpx solid #eee;
}

.tips {
    background: #f7f8fa;
    padding: 30rpx;
    border-radius: 12rpx;
    border-left: 6rpx solid #1989fa;
}

.tips text {
    display: block;
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
    margin-bottom: 10rpx;
}

.tips text:last-child {
    margin-bottom: 0;
}
