<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="wxs" />

<view class="ipms-tree-select" style="height: {{ utils.addUnit(height) }}">
    <scroll-view scroll-y class="ipms-tree-select__nav">
        <ipms-sidebar
            active-key="{{ mainActiveIndex }}"
            bind:change="onClickNav"
            custom-class="ipms-tree-select__nav__inner"
        >
            <ipms-sidebar-item
                wx:for="{{ items }}"
                wx:key="index"
                custom-class="main-item-class"
                active-class="main-active-class"
                disabled-class="main-disabled-class"
                badge="{{ item.badge }}"
                dot="{{ item.dot }}"
                title="{{ item.text }}"
                disabled="{{ item.disabled }}"
            />
        </ipms-sidebar>
    </scroll-view>
    <scroll-view scroll-y class="ipms-tree-select__content">
        <slot name="content" />
        <view
            wx:for="{{ subItems }}"
            wx:key="id"
            class="ipms-ellipsis content-item-class {{ utils.bem('tree-select__item', { active: wxs.isActive(activeId, item.id), disabled: item.disabled }) }} {{ wxs.isActive(activeId, item.id) ? 'content-active-class' : '' }} {{ item.disabled ? 'content-disabled-class' : '' }}"
            data-item="{{ item }}"
            bind:tap="onSelectItem"
        >
            {{ item.text }}
            <ipms-icon
                wx:if="{{ wxs.isActive(activeId, item.id) }}"
                name="{{ selectedIcon }}"
                size="16px"
                class="ipms-tree-select__selected"
            />
        </view>
    </scroll-view>
</view>
