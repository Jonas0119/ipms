@import '../common/index.wxss';

.ipms-skeleton {
    display: -webkit-flex;
    display: flex;
    box-sizing: border-box;
    width: 100%;
    padding: 12px 16px;
}

.ipms-skeleton--cell {
    padding: 0;
}

.ipms-skeleton__avatar {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: #f2f3f5;
}

.ipms-skeleton__avatar--round {
    border-radius: 100%;
}

.ipms-skeleton__content {
    -webkit-flex: 1;
    flex: 1;
}

.ipms-skeleton__avatar + .ipms-skeleton__content {
    padding-top: 8px;
}

.ipms-skeleton__row,
.ipms-skeleton__title {
    height: 16px;
    background-color: #f2f3f5;
}

.ipms-skeleton__title {
    margin: 0;
}

.ipms-skeleton__row:not(:first-child) {
    margin-top: 12px;
}

.ipms-skeleton__title + .ipms-skeleton__row {
    margin-top: 20px;
}

.ipms-skeleton--animate {
    animation: ipms-skeleton-blink 1.2s ease-in-out infinite;
}
@keyframes ipms-skeleton-blink {
    50% {
        opacity: 0.6;
    }
}
