<wxs src="../common/common.wxs" module="common" />
<wxs src="./index.wxs" module="mission" />

<view class="container">
    <ipms-cell-group title="任务信息" wx:if="{{fetching}}">
        <ipms-cell is-detail title="任务编号：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="开始日期：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="结束日期：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="上报时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="任务分类：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="巡检线路：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="任务状态：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="创建时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="创建人：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="任务信息">
            <ipms-cell
                is-detail
                title="任务编号："
                value="{{common.number('MN', detail.info.created_at, detail.info.id)}}"
            />
            <ipms-cell is-detail title="开始日期：" value="{{common.date(detail.info.start_date, false)}}" />
            <ipms-cell is-detail title="结束日期：" value="{{common.date(detail.info.end_date, false)}}" />
            <ipms-cell
                is-detail
                title="上报时间："
                value="{{common.hour(detail.info.start_hour)}}至{{common.hour(detail.info.end_hour)}}"
            />
            <ipms-cell is-detail title="任务分类：" value="{{detail.info.category}}" />
            <ipms-cell is-detail title="巡检线路：" value="{{detail.info.line}}" />
            <ipms-cell is-detail title="任务状态：">
                <block wx:if="{{detail.info.cancel}}">
                    <ipms-tag round color="#eb2f96">已取消</ipms-tag>
                </block>
                <block wx:elif="{{detail.info.start_date > now}}">
                    <ipms-tag round color="#ffe58f">未开始</ipms-tag>
                </block>
                <block wx:elif="{{detail.info.end_date < now}}">
                    <ipms-tag round color="#f90">已结束</ipms-tag>
                </block>
                <block wx:else>
                    <ipms-tag round color="#52c41a">进行中</ipms-tag>
                </block>
            </ipms-cell>
            <ipms-cell is-detail title="创建时间：" value="{{common.date(detail.info.created_at)}}" />
            <ipms-cell
                is-detail
                title="创建人："
                border="{{false}}"
                is-link
                url="/pages/colleague/detail?id={{detail.disposeInfo.id}}"
                clickable
                value="{{detail.disposeInfo.real_name}}"
            />
        </ipms-cell-group>

        <ipms-cell-group title="执行情况">
            <view class="node-detail">
                <ipms-row>
                    <ipms-col
                        span="6"
                        wx:for="{{nodes}}"
                        wx:key="index"
                        data-status="{{item.status}}"
                        bind:tap="showDetail"
                        data-id="{{item.id}}"
                        custom-class="node-wrapper"
                    >
                        <view class="node status{{item.status}}">
                            <view class="status">
                                {{ mission.statusText(item.status) }}
                            </view>
                            <view class="year">
                                {{ item.year }}
                            </view>
                            <view class="date">
                                {{ item.date }}
                            </view>
                        </view>
                    </ipms-col>
                </ipms-row>
            </view>
        </ipms-cell-group>
    </view>

    <ipms-copyright />

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
</view>
