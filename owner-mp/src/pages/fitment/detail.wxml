<wxs src="../common/common.wxs" module="common" />
<wxs src="../payment/index.wxs" module="payment" />

<view class="container {{detail.step === 2 ? 'padding' : ''}}">
    <ipms-notice-bar
        text="装修需缴纳装修保证金，因法律法规对保证金规范要求不明确，当前不提供在线支付功能，请前往物业办公室办理相关手续。"
        wx:if="{{detail.step === 1 && detail.fitment_pledge}}"
    />

    <ipms-steps steps="{{steps}}" active="{{detail.step - 1}}" />

    <ipms-cell-group title="反馈信息" wx:if="{{fetching}}">
        <ipms-cell is-detail title="工单编号：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="所在小区：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="装修地址：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="报备时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="退还保证金账户信息" wx:if="{{detail.step === 4 && detail.fitment_pledge}}">
            <view wx:if="{{!detail.is_return_cash_deposit}}">
                <ipms-cell
                    is-detail
                    title="退款状态："
                    label="当前状态可以修改退款账户信息"
                    value="未退款"
                    border="{{false}}"
                />
            </view>
            <view wx:else>
                <ipms-cell is-detail title="退款状态：" value="已退款" />
                <ipms-cell is-detail title="操作人员：">
                    <view class="user-detail">
                        <view class="avatar">
                            <image
                                class="avatar-url"
                                src="{{ ASSETS_HOST }}{{ detail.returnInfo.avatar_url }}"
                                lazy-load
                                mode="scaleToFill"
                            />
                        </view>
                        <view class="main-info">
                            <view class="name">
                                {{detail.returnInfo.real_name}}
                            </view>
                            <view class="department">
                                {{detail.returnInfo.department ? detail.returnInfo.department : '-'}}
                                {{detail.returnInfo.job ? detail.returnInfo.job : '-'}}
                            </view>
                        </view>
                    </view>
                </ipms-cell>
                <ipms-cell is-detail title="退款户名：" value="{{detail.return_name}}" />
                <ipms-cell is-detail title="退款银行：" value="{{detail.return_bank}}" />
                <ipms-cell is-detail title="退款账户：" value="{{detail.return_bank_id}}" />
                <ipms-cell is-detail title="退款时间：" value="{{common.date(detail.returned_at)}}" border="{{false}}" />
            </view>
        </ipms-cell-group>

        <ipms-cell-group title="验收信息" wx:if="{{detail.step === 4}}">
            <ipms-cell is-detail title="验收人员：">
                <ipms-employee info="{{detail.confirmInfo}}" />
            </ipms-cell>
            <ipms-cell is-detail title="验收时间：" border="{{false}}" value="{{common.date(detail.confirmed_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="完工确认" wx:if="{{detail.step >= 3}}">
            <ipms-cell is-detail title="确认时间：" border="{{false}}" value="{{common.date(detail.finished_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group
            title="退还保证金账户信息"
            wx:if="{{detail.step >= 2 && detail.fitment_pledge && !detail.is_return_cash_deposit}}"
        >
            <ipms-field
                label="户名"
                maxlength="{{ 12 }}"
                show-word-limit
                model:value="{{ return_name }}"
                placeholder="请输入户名"
            />
            <ipms-field
                label="银行"
                maxlength="{{ 20 }}"
                show-word-limit
                model:value="{{ return_bank }}"
                placeholder="请输入银行"
            />
            <ipms-field
                label="账号"
                maxlength="{{ 30 }}"
                show-word-limit
                border="{{false}}"
                model:value="{{ return_bank_id }}"
                placeholder="请输入账号"
            />
            <ipms-cell border="{{false}}">
                <ipms-button size="small" bind:click="updateReturn" loading="{{returnSubmiting}}" type="info" round>
                    {{detail.return_bank_id ? '更新' : '确认'}}
                </ipms-button>
            </ipms-cell>
        </ipms-cell-group>

        <ipms-cell-group title="许可信息" wx:if="{{detail.step >= 2}}">
            <ipms-cell is-detail title="许可人员：">
                <ipms-employee info="{{detail.agreeInfo}}" />
            </ipms-cell>
            <ipms-cell is-detail title="保证金：" value="{{payment.yuan(detail.cash_deposit)}}元" />
            <ipms-cell is-detail title="受理时间：" border="{{false}}" value="{{common.date(detail.agreed_at)}}" />
        </ipms-cell-group>

        <ipms-cell-group title="报备信息">
            <ipms-cell is-detail title="工单编号：" value="{{detail.created_at}}{{detail.id}}" />
            <ipms-cell is-detail title="所在小区：" value="{{detail.community_name}}" />
            <ipms-cell is-detail title="装修地址：" value="{{common.building(detail, false)}}" />
            <ipms-cell is-detail title="报备时间：" value="{{common.date(detail.created_at)}}" />
        </ipms-cell-group>
    </view>

    <ipms-button
        custom-class="btn"
        block
        type="info"
        loading="{{finishSubmiting}}"
        wx:if="{{detail.step === 2}}"
        bind:click="finishSubmit"
    >
        确认完工
    </ipms-button>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
