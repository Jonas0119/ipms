<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <view wx:if="{{!fetching}}">
        <view class="title">{{title}}</view>
        <view class="expire">截止至{{common.date(expire, false)}}</view>

        <view class="question" wx:for="{{questions}}" wx:key="index">
            <view class="question-title">{{index + 1}}.{{item.title}}</view>

            <block wx:if="{{item.type === 1}}">
                <ipms-radio-group data-index="{{index}}" value="{{answers[index]}}" bind:change="onQuestionChange">
                    <ipms-radio
                        wx:for="{{item.options}}"
                        wx:for-item="option"
                        wx:for-index="key"
                        wx:key="key"
                        name="{{option.id}}"
                        custom-class="option"
                    >
                        {{option.option_val}}
                    </ipms-radio>
                </ipms-radio-group>
            </block>
            <block wx:else>
                <ipms-checkbox-group data-index="{{index}}" value="{{answers[index]}}" bind:change="onQuestionChange">
                    <ipms-checkbox
                        wx:for="{{item.options}}"
                        wx:for-item="option"
                        wx:for-index="key"
                        wx:key="key"
                        name="{{option.id}}"
                        shape="square"
                        custom-class="option"
                    >
                        {{option.option_val}}
                    </ipms-checkbox>
                </ipms-checkbox-group>
            </block>
        </view>

        <ipms-button type="info" block round loading="{{submiting}}" bind:click="submit" custom-class="btn">
            提交
        </ipms-button>
    </view>
    <view wx:else>
        <ipms-skeleton row="{{ 1 }}" title />

        <view class="question" wx:for="{{4}}" wx:key="index">
            <ipms-skeleton row="{{ 3 }}" title />
        </view>
    </view>

    <ipms-copyright />
    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
