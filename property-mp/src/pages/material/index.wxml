<view class="container">
    <ipms-cell-group>
        <ipms-cell title="物品名称" title-width="100px" value="{{info.name}}" wx:if="{{info.name}}" is-detail />
        <ipms-cell title="仓储数量" title-width="100px" value="{{info.total}}" wx:if="{{info.total}}" is-detail />
        <ipms-cell
            title="领用人"
            clickable
            is-link
            is-detail="{{used_by ? true : false}}"
            title-width="100px"
            value="{{used_by ? used_by_name : '请选择'}}"
            bind:click="showColleague"
        />
        <ipms-field label="领用数量" type="number" model:value="{{ total }}" placeholder="请输入领用数量" />
        <ipms-field
            label="领用原因"
            type="textarea"
            maxlength="{{ 128 }}"
            show-word-limit
            model:value="{{ reason }}"
            placeholder="请输入领用原因"
            border="{{false}}"
        />
    </ipms-cell-group>

    <ipms-button custom-class="btn" block loading="{{submiting}}" type="info" bind:click="submit">
        领用
    </ipms-button>

    <ipms-colleague show="{{show}}" bind:close="hideColleague" bind:select="onSelectColleague" />

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
    <ipms-copyright />
</view>
