<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-tabs active="{{ activeTabIndex }}" bind:change="onTabChange">
        <ipms-tab title="采购申请">
            <ipms-cell-group>
                <ipms-cell title="采购金额" is-detail value="{{total}}" />
                <ipms-field
                    label="采购备注"
                    type="textarea"
                    maxlength="{{ 512 }}"
                    show-word-limit
                    autosize
                    border="{{false}}"
                    model:value="{{ remark }}"
                    placeholder="请输入采购备注"
                />
            </ipms-cell-group>

            <ipms-cell-group title="采购项目" wx:if="{{items.length}}">
                <ipms-collapse value="{{ activeCollapse }}" bind:change="onCollapseChange">
                    <ipms-collapse-item
                        wx:for="{{items}}"
                        title="项目{{index + 1}}（{{item.fee}}元）"
                        wx:key="index"
                        name="{{index}}"
                    >
                        <view class="row">
                            <view class="label">采购物料：</view>
                            <block
                                wx:for="{{options.material}}"
                                wx:for-index="key"
                                wx:for-item="row"
                                wx:key="key"
                                wx:if="{{row.id === item.material_id}}"
                            >
                                {{row.name}}
                            </block>
                        </view>
                        <view class="row">
                            <view class="label">采购数量：</view>
                            {{item.total}}
                        </view>
                        <view class="row">
                            <view class="label">采购总金额：</view>
                            {{item.fee}}
                        </view>
                        <view class="row">
                            <view class="label">供应商：</view>
                            <block
                                wx:for="{{options.supplier}}"
                                wx:for-index="key"
                                wx:for-item="row"
                                wx:key="key"
                                wx:if="{{row.id === item.supplier_id}}"
                            >
                                {{row.title}}
                            </block>
                        </view>
                        <view class="footer">
                            <ipms-button size="small" round type="danger" data-index="{{index}}" bind:click="remove">
                                删除
                            </ipms-button>
                            <ipms-button
                                size="small"
                                custom-class="btn-ml"
                                round
                                type="info"
                                data-index="{{index}}"
                                bind:click="update"
                            >
                                修改
                            </ipms-button>
                        </view>
                    </ipms-collapse-item>
                </ipms-collapse>
            </ipms-cell-group>

            <view class="append-btn-box">
                <ipms-button block round bind:click="appendItem">添加采购项目</ipms-button>
            </view>

            <ipms-button
                custom-class="btn"
                block
                wx:if="{{activeTabIndex === 0}}"
                loading="{{submiting}}"
                type="info"
                bind:click="submit"
            >
                提交申请
            </ipms-button>

            <ipms-copyright />
        </ipms-tab>

        <ipms-tab title="历史申请">
            <ipms-list
                fetching="{{fetching}}"
                page_num="{{page_num}}"
                page_amount="{{page_size}}"
                list="{{list}}"
                empty="暂无采购申请"
                icon="refound"
                withFilter
            >
                <ipms-list-item
                    wx:for="{{list}}"
                    title="{{common.number('MF', item.created_at, item.id)}}"
                    wx:key="index"
                    url="/pages/purchase/detail?id={{item.id}}"
                >
                    <ipms-list-item-info label="备注信息">
                        {{ item.remark ? item.remark : '-'}}
                    </ipms-list-item-info>
                    <ipms-list-item-info label="采购金额">
                        {{ item.total }}元
                    </ipms-list-item-info>
                    <ipms-list-item-info label="申请结果">
                        <block wx:if="{{item.cancel}}">
                            <ipms-tag round color="#ff976a">已取消</ipms-tag>
                        </block>
                        <block wx:elif="{{item.success === null}}">
                            <ipms-tag round color="#91d5ff">审批中</ipms-tag>
                        </block>
                        <block wx:elif="{{!item.success}}">
                            <ipms-tag round color="#ed4014">驳回</ipms-tag>
                        </block>
                        <block wx:else>
                            <ipms-tag round color="#52c41a">成功</ipms-tag>
                        </block>
                    </ipms-list-item-info>
                    <ipms-list-item-info label="申请时间">
                        {{ common.date(item.created_at) }}
                    </ipms-list-item-info>
                </ipms-list-item>
            </ipms-list>
        </ipms-tab>
    </ipms-tabs>

    <ipms-toast id="ipms-toast" />
    <ipms-notify id="ipms-notify" />
</view>
