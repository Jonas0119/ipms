<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./options.wxs" module="computed" />

<view class="{{ utils.bem('share-sheet__options', { border: showBorder }) }}">
    <view
        wx:for="{{ options }}"
        wx:key="index"
        class="ipms-share-sheet__option"
        data-index="{{ index }}"
        bindtap="onSelect"
    >
        <button class="ipms-share-sheet__button" open-type="{{ item.openType }}">
            <image src="{{ computed.getIconURL(item.icon) }}" class="ipms-share-sheet__icon" />
        </button>
        <view wx:if="{{ item.name }}" class="ipms-share-sheet__name">{{ item.name }}</view>
        <view wx:if="{{ item.description }}" class="ipms-share-sheet__option-description">
            {{ item.description }}
        </view>
    </view>
</view>
