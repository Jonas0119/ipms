<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-cell-group title="采购详细" wx:if="{{fetching}}">
        <ipms-cell is-detail title="流程编号：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请人：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="采购金额：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="采购备注：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请时间：">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
        <ipms-cell is-detail title="申请结果：" border="{{false}}">
            <ipms-skeleton in-cell row="2" />
        </ipms-cell>
    </ipms-cell-group>
    <view wx:else>
        <ipms-cell-group title="采购详细">
            <ipms-cell
                is-detail
                title="流程编号："
                value="{{common.number('MF', detail.info.created_at, detail.info.id)}}"
            />
            <ipms-cell
                is-detail
                title="申请人："
                is-link
                url="/pages/colleague/detail?id={{detail.info.created_by}}"
                clickable
                wx:if="{{detail.info.created_by !== userInfo.id}}"
                value="{{detail.info.real_name}}"
            />
            <ipms-cell is-detail title="采购金额：" value="{{detail.info.total}}元" />
            <ipms-cell is-detail title="采购备注：" value="{{detail.info.remark ? detail.info.remark : '-'}}" />
            <ipms-cell is-detail title="申请时间：" value="{{common.date(detail.info.created_at)}}" />
            <ipms-cell is-detail title="申请结果：" border="{{detail.canceled_at ? true : false}}">
                <block wx:if="{{detail.info.cancel}}">
                    <ipms-tag round color="#ff976a">已撤销</ipms-tag>
                </block>
                <block wx:elif="{{detail.info.success === null}}">
                    <ipms-tag round color="#91d5ff">审批中</ipms-tag>
                </block>
                <block wx:elif="{{!detail.info.success}}">
                    <ipms-tag round color="#ed4014">驳回</ipms-tag>
                </block>
                <block wx:else>
                    <ipms-tag round color="#52c41a">成功</ipms-tag>
                </block>
            </ipms-cell>
            <ipms-cell
                is-detail
                title="撤销时间："
                wx:if="{{detail.info.cancel}}"
                border="{{false}}"
                value="{{common.date(detail.info.canceled_at)}}"
            />
        </ipms-cell-group>

        <ipms-cell-group title="采购项目">
            <ipms-collapse value="{{ activeCollapse }}" bind:change="onCollapseChange">
                <ipms-collapse-item
                    wx:for="{{detail.items}}"
                    title="项目{{index + 1}}（{{item.fee}}元）"
                    wx:key="index"
                    name="{{index}}"
                >
                    <view class="row">
                        <view class="label">采购物料：</view>
                        {{item.material}}
                    </view>
                    <view class="row">
                        <view class="label">采购数量：</view>
                        {{item.total}}
                    </view>
                    <view class="row">
                        <view class="label">采购总金额：</view>
                        {{item.fee}}
                    </view>
                    <view class="row">
                        <view class="label">供应商：</view>
                        {{item.supplier}}
                    </view>
                    <view class="row">
                        <view class="label">供应商联系人：</view>
                        {{item.linkman}}
                    </view>
                    <view class="row">
                        <view class="label">供应商联系电话：</view>
                        {{item.phone}}
                    </view>
                    <view class="row">
                        <view class="label">供应商开户行：</view>
                        {{ item.bank_name ? item.bank_name : '-' }}
                    </view>
                    <view class="row">
                        <view class="label">供应商银行账号：</view>
                        {{ item.bank_id ? item.bank_id : '-' }}
                    </view>
                    <view class="row">
                        <view class="label">供应商开户行地址：</view>
                        {{ item.bank_address ? item.bank_address : '-' }}
                    </view>
                </ipms-collapse-item>
            </ipms-collapse>
        </ipms-cell-group>

        <view
            class="cancel-btn-box"
            wx:if="{{!detail.info.cancel && detail.info.success === null && detail.info.created_by === userInfo.id}}"
        >
            <ipms-button custom-class="cancel-btn" block type="warning" loading="{{canceling}}" bind:click="doCancel">
                撤销申请
            </ipms-button>
        </view>

        <ipms-cell-group title="审批流程">
            <ipms-workflow
                steps="{{detail.steps}}"
                info="{{detail.info}}"
                label="采购金额"
                userId="{{userInfo.id}}"
                bind:approved="onApproved"
                bind:relationed="onRelationed"
            />
        </ipms-cell-group>
    </view>

    <ipms-copyright />

    <!-- 全局提示 -->
    <ipms-dialog id="ipms-dialog" />
    <ipms-notify id="ipms-notify" />
    <ipms-toast id="ipms-toast" />
</view>
