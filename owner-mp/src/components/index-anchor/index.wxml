<view class="ipms-index-anchor-wrapper" style="{{ wrapperStyle }}">
    <view
        class="ipms-index-anchor {{ active ? 'ipms-index-anchor--active ipms-hairline--bottom' : '' }}"
        style="{{ anchorStyle }}"
    >
        <slot wx:if="{{ useSlot }}" />
        <block wx:else>
            <text>{{ index }}</text>
        </block>
    </view>
</view>
