<!--
 +----------------------------------------------------------------------
 | 开源物业管理系统，敬请使用
 +----------------------------------------------------------------------
-->
<view>
    <view class="ipms-car-number-items">
        <view class="ipms-car-number-items-box" bindtap="openKeyboard">
            <view class="ipms-car-number-items-province ipms-car-number-items-box-list">{{carNumber[0] || ""}}</view>
            <view class="ipms-car-number-items-city ipms-car-number-items-box-list">{{carNumber[1] || ""}}</view>
        </view>
        <!-- 常规 -->
        <view class="ipms-car-number-item" bindtap="openKeyboard">{{carNumber[2] || ''}}</view>
        <view class="ipms-car-number-item" bindtap="openKeyboard">{{carNumber[3] || ''}}</view>
        <view class="ipms-car-number-item" bindtap="openKeyboard">{{carNumber[4] || ''}}</view>
        <view class="ipms-car-number-item" bindtap="openKeyboard">{{carNumber[5] || ''}}</view>
        <view class="ipms-car-number-item" bindtap="openKeyboard">{{carNumber[6] || ''}}</view>
        <!-- 新能源 -->
        <view class="ipms-car-number-item" bindtap="openKeyboard" wx:if="{{isNewEnergy}}">
            {{carNumber[7] || ''}}
        </view>
    </view>

    <!-- 虚拟键盘 -->
    <view class="ipms-keyboard" hidden="{{!keyboardVisible}}">
        <view class="ipms-keyboard-close">
            <view class="ipms-keyboard-close-btn" bindtap="closeKeyboard">
                <ipms-icon name="keyboard-hide" />
            </view>
        </view>
        <!-- 省份简写键盘 -->
        <view class="ipms-keyboard-item" hidden="{{carNumber[0]}}">
            <view class="ipms-keyboard-line" wx:for="{{provinces}}" wx:key="index">
                <view
                    class="ipms-keyboard-btn"
                    wx:for="{{item}}"
                    wx:key="index"
                    data-val="{{itemlist}}"
                    wx:for-item="itemlist"
                    bindtap="bindChoose"
                >
                    {{itemlist}}
                </view>
            </view>
            <view class="ipms-keyboard-del" bindtap="bindDelChoose">
                <ipms-icon name="backspace" />
            </view>
        </view>
        <!-- 车牌号码选择键盘 -->
        <view class="ipms-keyboard-item iscarnumber" hidden="{{!carNumber[0]}}">
            <view class="ipms-keyboard-line" wx:for="{{numbers}}" wx:key="index">
                <view
                    class="ipms-keyboard-btn"
                    wx:for="{{item}}"
                    wx:key="index"
                    data-val="{{itemlist}}"
                    wx:for-item="itemlist"
                    bindtap="bindChoose"
                >
                    {{itemlist}}
                </view>
            </view>
            <view class="ipms-keyboard-del" bindtap="bindDelChoose">
                <ipms-icon name="backspace" />
            </view>
        </view>
    </view>
</view>
