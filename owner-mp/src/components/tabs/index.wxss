@import '../common/index.wxss';

.ipms-tabs {
    position: relative;
    -webkit-tap-highlight-color: transparent;
}

.ipms-tabs__wrap {
    display: flex;
    overflow: hidden;
}

.ipms-tabs__wrap--scrollable .ipms-tab {
    flex: 0 0 22%;
}

.ipms-tabs__wrap--scrollable .ipms-tab--complete {
    flex: 1 0 auto !important;
    padding: 0 12px;
}

.ipms-tabs__wrap--scrollable .ipms-tabs__nav--complete {
    padding-right: 8px;
    padding-left: 8px;
}

.ipms-tabs__scroll {
    background-color: #fff;
}

.ipms-tabs__scroll--line {
    box-sizing: initial;
    height: calc(100% + 15px);
}

.ipms-tabs__scroll--card {
    margin: 0 16px;
}

.ipms-tabs__scroll::-webkit-scrollbar {
    display: none;
}

.ipms-tabs__nav {
    position: relative;
    display: -webkit-flex;
    display: flex;
    -webkit-user-select: none;
    user-select: none;
}

.ipms-tabs__nav--card {
    box-sizing: border-box;
    height: 30px;
    border: 1px solid #ee0a24;
    border-radius: 2px;
}

.ipms-tabs__nav--card .ipms-tab {
    color: #ee0a24;
    line-height: 28px;
    border-right: 1px solid #ee0a24;
}

.ipms-tabs__nav--card .ipms-tab:last-child {
    border-right: none;
}

.ipms-tabs__nav--card .ipms-tab.ipms-tab--active {
    color: #fff;
    background-color: #ee0a24;
}

.ipms-tabs__nav--card .ipms-tab--disabled {
    color: #c8c9cc;
}

.ipms-tabs__line {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    height: 3px;
    border-radius: 3px;
    background-color: #ee0a24;
}

.ipms-tabs__track {
    position: relative;
    width: 100%;
    height: 100%;
}

.ipms-tabs__track--animated {
    display: -webkit-flex;
    display: flex;
    transition-property: left;
}

.ipms-tabs__content {
    overflow: hidden;
}

.ipms-tabs--line .ipms-tabs__wrap {
    height: 44px;
}

.ipms-tabs--card .ipms-tabs__wrap {
    height: 30px;
}

.ipms-tab {
    position: relative;
    -webkit-flex: 1;
    flex: 1;
    box-sizing: border-box;
    min-width: 0;
    padding: 0 5px;
    text-align: center;
    cursor: pointer;
    color: #646566;
    font-size: 14px;
    line-height: 44px;
}

.ipms-tab--active {
    font-weight: 500;
    color: #323233;
}

.ipms-tab--disabled {
    color: #c8c9cc;
}

.ipms-tab__title__info {
    position: relative !important;
    top: -1px !important;
    display: inline-block;
    -webkit-transform: translateX(0) !important;
    transform: translateX(0) !important;
}
