@import '../common/index.wxss';

.ipms-steps {
    overflow: hidden;
    background-color: #fff;
}

.ipms-steps--horizontal {
    padding: 10px;
}

.ipms-steps--horizontal .ipms-step__wrapper {
    position: relative;
    display: -webkit-flex;
    display: flex;
    overflow: hidden;
}

.ipms-steps--vertical {
    padding-left: 10px;
}

.ipms-steps--vertical .ipms-step__wrapper {
    padding: 0 0 0 20px;
}

.ipms-step {
    position: relative;
    -webkit-flex: 1;
    flex: 1;
    font-size: 14px;
    color: #969799;
}

.ipms-step--finish {
    color: #323233;
}

.ipms-step__circle {
    border-radius: 50%;
    width: 5px;
    height: 5px;
    background-color: #969799;
}

.ipms-step--horizontal {
    padding-bottom: 14px;
}

.ipms-step--horizontal:first-child .ipms-step__title {
    -webkit-transform: none;
    transform: none;
}

.ipms-step--horizontal:first-child .ipms-step__circle-container {
    padding: 0 8px 0 0;
    -webkit-transform: translate3d(0, 50%, 0);
    transform: translate3d(0, 50%, 0);
}

.ipms-step--horizontal:last-child {
    position: absolute;
    right: 0;
    width: auto;
}

.ipms-step--horizontal:last-child .ipms-step__title {
    text-align: right;
    -webkit-transform: none;
    transform: none;
}

.ipms-step--horizontal:last-child .ipms-step__circle-container {
    right: 0;
    padding: 0 0 0 8px;
    -webkit-transform: translate3d(0, 50%, 0);
    transform: translate3d(0, 50%, 0);
}

.ipms-step--horizontal .ipms-step__circle-container {
    position: absolute;
    bottom: 6px;
    z-index: 1;
    -webkit-transform: translate3d(-50%, 50%, 0);
    transform: translate3d(-50%, 50%, 0);
    background-color: #fff;
    padding: 0 8px;
}

.ipms-step--horizontal .ipms-step__title {
    display: inline-block;
    -webkit-transform: translate3d(-50%, 0, 0);
    transform: translate3d(-50%, 0, 0);
    font-size: 12px;
}

.ipms-step--horizontal .ipms-step__line {
    position: absolute;
    right: 0;
    bottom: 6px;
    left: 0;
    height: 1px;
    -webkit-transform: translate3d(0, 50%, 0);
    transform: translate3d(0, 50%, 0);
    background-color: #ebedf0;
}

.ipms-step--horizontal.ipms-step--process {
    color: #323233;
}

.ipms-step--horizontal.ipms-step--process .ipms-step__icon {
    display: block;
    line-height: 1;
    font-size: 12px;
}

.ipms-step--vertical {
    padding: 10px 10px 10px 0;
    line-height: 18px;
}

.ipms-step--vertical:after {
    border-bottom-width: 1px;
}

.ipms-step--vertical:last-child:after {
    border-bottom-width: none;
}

.ipms-step--vertical:first-child:before {
    position: absolute;
    top: 0;
    left: -15px;
    z-index: 1;
    width: 1px;
    height: 20px;
    content: '';
    background-color: #fff;
}

.ipms-step--vertical .ipms-step__circle,
.ipms-step--vertical .ipms-step__icon,
.ipms-step--vertical .ipms-step__line {
    position: absolute;
    top: 19px;
    left: -14px;
    z-index: 2;
    -webkit-transform: translate3d(-50%, -50%, 0);
    transform: translate3d(-50%, -50%, 0);
}

.ipms-step--vertical .ipms-step__icon {
    line-height: 1;
    font-size: 12px;
}

.ipms-step--vertical .ipms-step__line {
    z-index: 1;
    width: 1px;
    height: 100%;
    -webkit-transform: translate3d(-50%, 0, 0);
    transform: translate3d(-50%, 0, 0);
    background-color: #ebedf0;
}
