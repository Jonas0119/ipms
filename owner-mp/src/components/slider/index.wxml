<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />

<view
    class="custom-class {{ utils.bem('slider', { disabled }) }}"
    style="{{ inactiveColor ? 'background:' + inactiveColor : '' }}"
    bind:tap="onClick"
>
    <view class="ipms-slider__bar" style="{{ barStyle }};{{ computed.barStyle(barHeight, activeColor) }}">
        <view
            class="ipms-slider__button-wrapper"
            bind:touchstart="onTouchStart"
            catch:touchmove="onTouchMove"
            bind:touchend="onTouchEnd"
            bind:touchcancel="onTouchEnd"
        >
            <slot wx:if="{{ useButtonSlot }}" name="button" />
            <view wx:else class="ipms-slider__button" />
        </view>
    </view>
</view>
