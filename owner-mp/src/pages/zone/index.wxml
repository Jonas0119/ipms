<!--
 +----------------------------------------------------------------------
 | 开源物业管理系统，敬请使用
 +----------------------------------------------------------------------
-->
<view class="container">
    <view class="header-placeholder"></view>

    <view class="header-wrapper">
        <view class="header">
            <view class="avatar">
                <image
                    src="{{ ASSETS_HOST }}{{ userInfo.avatar_url }}"
                    wx:if="{{userInfo.avatar_url}}"
                    lazy-load="true"
                    mode="scaleToFill"
                />
            </view>

            <view class="is-identity">
                <view class="txt {{ userInfo.phone ? '' : 'unable' }}">{{ userInfo.phone ? '已认证' : '未认证' }}</view>
                <view class="icon">
                    <ipms-icon name="identity" custom-class="identity {{ userInfo.phone ? '' : 'unable' }}"></ipms-icon>
                </view>
            </view>

            <view class="is-approve">
                <view class="icon">
                    <ipms-icon name="approve" custom-class="approve"></ipms-icon>
                </view>
                <view class="txt">
                    <block wx:if="{{ communityInfo.list.length === 1 }}">
                        {{ communityInfo.list[0].name }}
                    </block>
                    <block wx:else>
                        {{ communityInfo.list.length }}小区
                    </block>
                </view>
            </view>

            <view class="info">
                <view class="name">{{ userInfo.nick_name }}</view>
                <view class="signature">{{ userInfo.signature }}</view>
            </view>

            <view class="self">
                <ipms-row>
                    <ipms-col span="6">
                        <navigator url="/pages/payment/index" class="self-item">
                            <view class="fill-icon pay">
                                <ipms-icon name="pay"></ipms-icon>
                            </view>
                            <view>我的缴费</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/repair/index" class="self-item">
                            <view class="fill-icon maintain">
                                <ipms-icon name="maintain"></ipms-icon>
                            </view>
                            <view>我的维修</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/complain/index" class="self-item">
                            <view class="fill-icon report">
                                <ipms-icon name="report"></ipms-icon>
                            </view>
                            <view>我的投诉</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/pet/index" class="self-item">
                            <view class="fill-icon pet">
                                <ipms-icon name="pet"></ipms-icon>
                            </view>
                            <view>我的宠物</view>
                        </navigator>
                    </ipms-col>
                </ipms-row>
                <ipms-row>
                    <ipms-col span="6">
                        <navigator url="/pages/fitment/index" class="self-item">
                            <view class="fill-icon fitment">
                                <ipms-icon name="fitment"></ipms-icon>
                            </view>
                            <view>我的装修</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/move_car/index" class="self-item">
                            <view class="fill-icon movecar">
                                <ipms-icon name="movecar"></ipms-icon>
                            </view>
                            <view>我的挪车</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/vistor/index" class="self-item">
                            <view class="fill-icon vistor">
                                <ipms-icon name="vistor"></ipms-icon>
                            </view>
                            <view>我的访客</view>
                        </navigator>
                    </ipms-col>
                    <ipms-col span="6">
                        <navigator url="/pages/questionnaire/self" class="self-item">
                            <view class="fill-icon question">
                                <ipms-icon name="question"></ipms-icon>
                            </view>
                            <view>我的问卷</view>
                        </navigator>
                    </ipms-col>
                </ipms-row>
            </view>
        </view>
    </view>

    <ipms-cell-group title="账号信息">
        <ipms-cell is-link link-type="navigateTo" title="个人资料" url="/pages/zone/profile" />
        <ipms-cell is-link link-type="navigateTo" title="手机认证" url="/pages/zone/phone" />
        <ipms-cell is-link link-type="navigateTo" title="业主名片" url="/pages/zone/card" border="{{false}}" />
    </ipms-cell-group>

    <ipms-cell-group title="小区设置">
        <ipms-cell is-link link-type="navigateTo" title="住宅管理" url="/pages/community/index" />
        <ipms-cell is-link link-type="navigateTo" title="家人管理" url="/pages/family/index" border="{{false}}" />
    </ipms-cell-group>

    <ipms-cell-group title="联系我们">
        <ipms-cell is-link link-type="navigateTo" title="问题反馈" url="/pages/feedback/index" />
        <ipms-cell is-link link-type="navigateTo" title="功能建议" url="/pages/feedback/feature" />
        <ipms-cell is-link link-type="navigateTo" title="物业入驻" url="/pages/feedback/join" />
        <ipms-cell is-link link-type="navigateTo" title="关于我们" url="/pages/about/index" />
        <ipms-cell is-link link-type="navigateTo" title="用户协议" url="/pages/about/agreement" border="{{false}}" />
    </ipms-cell-group>

    <ipms-cell-group title="关于IPMS">
        <ipms-cell is-link title="检查新版本" value="当前版本：{{VERSION}}" clickable bind:tap="checkUpdate" />
    </ipms-cell-group>

    <ipms-copyright></ipms-copyright>
    <!-- 全局提示 -->
    <ipms-toast id="ipms-toast"></ipms-toast>
</view>
