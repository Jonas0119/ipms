@import '../common/index.wxss';

.ipms-tabbar {
    display: flex;
    box-sizing: initial;
    width: 100%;
    height: 50px;
    background-color: #fff;
}

.ipms-tabbar--fixed {
    position: fixed;
    bottom: 0;
    left: 0;
}

.ipms-tabbar--safe {
    padding-bottom: env(safe-area-inset-bottom);
}
