@import '../../../common/index.wxss';

.ipms-calendar {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100%;
    background-color: #fff;
}

.ipms-calendar__month-title {
    text-align: center;
    height: 44px;
    font-weight: 500;
    font-size: 14px;
    line-height: 44px;
}

.ipms-calendar__days {
    position: relative;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-user-select: none;
    user-select: none;
}

.ipms-calendar__month-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    color: rgba(242, 243, 245, 0.8);
    font-size: 160px;
}

.ipms-calendar__day,
.ipms-calendar__selected-day {
    display: -webkit-flex;
    display: flex;
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    justify-content: center;
    text-align: center;
}

.ipms-calendar__day {
    position: relative;
    width: 14.285%;
    height: 64px;
    font-size: 16px;
}

.ipms-calendar__day--end,
.ipms-calendar__day--multiple-middle,
.ipms-calendar__day--multiple-selected,
.ipms-calendar__day--start,
.ipms-calendar__day--start-end {
    color: #fff;
    background-color: #ee0a24;
}

.ipms-calendar__day--start {
    border-radius: 4px 0 0 4px;
}

.ipms-calendar__day--end {
    border-radius: 0 4px 4px 0;
}

.ipms-calendar__day--multiple-selected,
.ipms-calendar__day--start-end {
    border-radius: 4px;
}

.ipms-calendar__day--middle {
    color: #ee0a24;
}

.ipms-calendar__day--middle:after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: currentColor;
    content: '';
    opacity: 0.1;
}

.ipms-calendar__day--disabled {
    cursor: default;
    color: #c8c9cc;
}

.ipms-calendar__bottom-info,
.ipms-calendar__top-info {
    position: absolute;
    right: 0;
    left: 0;
    font-size: 10px;
    line-height: 14px;
}

@media (max-width: 350px) {
    .ipms-calendar__bottom-info,
    .ipms-calendar__top-info {
        font-size: 9px;
    }
}

.ipms-calendar__top-info {
    top: 6px;
}

.ipms-calendar__bottom-info {
    bottom: 6px;
}

.ipms-calendar__selected-day {
    width: 54px;
    height: 54px;
    color: #fff;
    background-color: #ee0a24;
    border-radius: 4px;
}
