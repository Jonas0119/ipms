<wxs src="../common/common.wxs" module="common" />

<view class="container">
    <ipms-dropdown-menu>
        <ipms-dropdown-item bind:change="onStatusChange" value="{{ status }}" options="{{ statusOptions }}" />
    </ipms-dropdown-menu>

    <ipms-list
        fetching="{{fetching}}"
        page_num="{{page_num}}"
        page_amount="{{page_amount}}"
        list="{{list}}"
        empty="暂无维修工单"
        icon="maintain"
        withFilter
    >
        <ipms-list-item
            wx:for="{{list}}"
            url="/pages/repair/detail?id={{item.id}}"
            title="{{common.number('R', item.created_at, item.id)}}"
            wx:key="index"
        >
            <ipms-list-item-info label="报修位置">
                <block wx:if="{{item.building_id === 0}}">
                    公共设施/区域
                </block>
                <block wx:else>
                    {{common.building(item)}}
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="维修类型">
                <block wx:if="{{item.repair_type === 1}}">
                    水暖
                </block>
                <block wx:elif="{{item.repair_type === 2}}">
                    电路
                </block>
                <block wx:elif="{{item.repair_type === 3}}">
                    门窗
                </block>
                <block wx:elif="{{item.repair_type === 4}}">
                    公共设施
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="问题描述">
                {{ item.description }}
            </ipms-list-item-info>
            <ipms-list-item-info label="当前进度">
                <block wx:if="{{item.step === 2}}">
                    <ipms-tag round color="#eb2f96">待确认工单</ipms-tag>
                </block>
                <block wx:elif="{{item.step === 3}}">
                    <ipms-tag round color="#ffe58f">待工单完成</ipms-tag>
                </block>
                <block wx:elif="{{item.step === 4}}">
                    <ipms-tag round color="#52c41a">工单已完成</ipms-tag>
                </block>
            </ipms-list-item-info>
            <ipms-list-item-info label="报修时间">
                {{ common.date(item.created_at) }}
            </ipms-list-item-info>
        </ipms-list-item>
    </ipms-list>

    <!-- 全局提示 -->
    <ipms-notify id="ipms-notify" />
</view>
